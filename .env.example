# URL pública del CMS editorial. No se necesita token: el blog consume endpoints públicos de solo lectura.
PUBLIC_CMS_URL=http://127.0.0.1:1337

# Solo aplica a comprobaciones de compilación heredadas. Órbita consulta el CMS
# en tiempo de ejecución y no necesita recompilarse al publicar una nota.
REQUIRE_CMS_FOR_BUILD=false

# Página de empresa en LinkedIn (campuslands-gt): el diploma se agrega al perfil con su logo.
PUBLIC_LINKEDIN_ORG_ID=136016494
