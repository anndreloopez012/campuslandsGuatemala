{
    "name": "campus-landing-astro",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=20",
        "npm": ">=10"
    },
    "scripts": {
        "dev": "astro dev",
        "dev:host": "astro dev --host 0.0.0.0",
        "start": "node ./dist/server/entry.mjs",
        "build": "astro build",
        "audit:seo": "npm run build && node scripts/audit-seo.mjs",
        "audit:images": "npm run build && node scripts/audit-images.mjs",
        "audit:scraping": "npm run build && node scripts/audit-scraping.mjs",
        "audit:recommendations": "npm run build && node scripts/audit-recommendations.mjs",
        "audit:links": "npm run build && node scripts/audit-links.mjs",
        "audit:blog": "npm run build && node scripts/audit-blog-seo.mjs",
        "audit:quality": "npm run build && node scripts/audit-seo.mjs && node scripts/audit-blog-seo.mjs && node scripts/audit-images.mjs && node scripts/audit-links.mjs && node scripts/audit-scraping.mjs && node scripts/audit-recommendations.mjs",
        "preview": "astro preview",
        "preview:host": "astro preview --host 0.0.0.0",
        "astro": "astro"
    },
    "dependencies": {
        "@astrojs/node": "^8.3.4",
        "@astrojs/tailwind": "^5.1.2",
        "@astrojs/vue": "^4.5.2",
        "astro": "^4.16.10",
        "astro-font": "^0.1.81",
        "astro-icon": "^1.1.2",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.47",
        "react": "^19.0.0",
        "sweetalert2": "^11.26.25",
        "tailwindcss": "^3.4.14",
        "vue": "^3.5.12"
    }
}
