---
import { Image } from "astro:assets";
import Campers from "~/assets/img/joinUs/campers-guatemala-grupo.webp";
import ContactButton from "../common/ContactButton.astro";
---

<section
  class="page-hero flex flex-col sections max-w-[1150px] self-center relative items-center justify-center md:flex-row md:justify-between gap-8 lg:gap-12"
  aria-label="Presentación del programa para campers"
>
  <div
    class="relative flex-wrap justify-betweem h-fit w-full flex md:max-w-[350px] lg:w-[425px] lg:max-w-[425px] flex-col gap-8 items-center md:items-start"
  >
    <h1 class="page-title gradient-text text-center lg:text-start">
      Transforma tu talento en éxito
    </h1>
    <p class="text-center lg:text-start text-sm lg:text-base leading-6 text-white">
      Campuslands forma a jóvenes con competencias únicas para su primer
      empleo de calidad en desarrollo de software.
    </p>
    <ContactButton
      tipo="insripcion"
      linkPage="https://estudiante-guate.campuslands.com/login"
      iconName="happyFace.svg"
    />
    <div class="joinus-hero-links">
      <a class="joinus-campus-link" href="/codeup/acceso/">
        <span class="joinus-campus-link__dot" aria-hidden="true"></span>
        ¿Ya eres camper CodeUp? <strong>Entra a tu campus</strong>
        <span aria-hidden="true">→</span>
      </a>
      <a class="joinus-campus-link joinus-campus-link--gallery" href="/galeria/?seccion=join-us">
        <span class="joinus-campus-link__dot joinus-campus-link__dot--gallery" aria-hidden="true"></span>
        Explorar <strong>galería de Sé un Camper</strong>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <figure class="joinus-hero-media w-full max-w-[550px]" aria-label="Grupo de campers de Campuslands Guatemala">
    <div class="joinus-hero-media__surface" data-image-shell="hero">
      <span class="joinus-hero-media__code" aria-hidden="true">&lt;talento_gt /&gt;</span>
      <Image
        src={Campers}
        alt="Cuatro campers de Campuslands Guatemala preparados para iniciar su formación tecnológica"
        width={963}
        widths={[320, 480, 550, 720, 963]}
        format="avif"
        quality={72}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        sizes="(max-width: 767px) calc(100vw - 32px), 550px"
        class="joinus-hero-media__photo"
      />
      <img
        src="/img/frames/joinus-hero-frame-back.svg"
        alt=""
        aria-hidden="true"
        width="1100"
        height="1200"
        class="joinus-hero-media__frame joinus-hero-media__frame--back"
        decoding="async"
      />
      <img
        src="/img/frames/joinus-hero-frame-front.svg"
        alt=""
        aria-hidden="true"
        width="1100"
        height="1200"
        class="joinus-hero-media__frame joinus-hero-media__frame--front"
        decoding="async"
      />
    </div>
  </figure>
</section>

<style scoped>
  .joinus-hero-media {
    margin: 0;
    filter: drop-shadow(0 24px 46px rgb(0 0 81 / 0.38));
  }

  .joinus-hero-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
  }

  .joinus-campus-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.95rem 0.55rem 0.75rem;
    border: 1px solid rgb(44 170 255 / 0.28);
    border-radius: 999px;
    color: rgb(223 245 255 / 0.84);
    background: linear-gradient(145deg, rgb(0 0 81 / 0.65), rgb(7 16 43 / 0.82));
    font-size: 0.86rem;
    text-decoration: none;
    backdrop-filter: blur(10px);
    box-shadow: 0 12px 28px rgb(0 0 81 / 0.32);
    transition: border-color 200ms ease, color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }

  .joinus-campus-link strong {
    color: #fff;
  }

  .joinus-campus-link:hover {
    border-color: rgb(44 170 255 / 0.65);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 14px 32px rgb(44 170 255 / 0.18);
  }

  .joinus-campus-link--gallery {
    border-color: rgb(0 217 164 / 0.36);
    background: linear-gradient(145deg, rgb(0 170 128 / 0.22), rgb(7 16 43 / 0.86));
  }

  .joinus-campus-link--gallery:hover {
    border-color: rgb(0 217 164 / 0.72);
    box-shadow: 0 14px 32px rgb(0 217 164 / 0.2);
  }

  .joinus-campus-link__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #00aa80;
    box-shadow: 0 0 0 0.25rem rgb(0 170 128 / 0.18), 0 0 0.8rem #2caaff;
  }

  .joinus-campus-link__dot--gallery {
    background: #2caaff;
    box-shadow: 0 0 0 0.25rem rgb(44 170 255 / 0.22), 0 0 0.8rem #00d9a4;
  }

  .joinus-hero-media__surface {
    position: relative;
    aspect-ratio: 11 / 12;
    isolation: isolate;
    overflow: hidden;
    border-radius: clamp(18px, 2.5vw, 30px);
    background:
      radial-gradient(circle at 72% 18%, rgb(44 170 255 / 0.2), transparent 38%),
      radial-gradient(circle at 18% 82%, rgb(0 170 128 / 0.16), transparent 34%),
      linear-gradient(145deg, #000051 0%, #000087 58%, #07102b 100%);
    transform: translateZ(0);
  }

  .joinus-hero-media__surface::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    content: "";
    pointer-events: none;
    opacity: .16;
    background-image:
      linear-gradient(rgb(87 187 255 / .2) 1px, transparent 1px),
      linear-gradient(90deg, rgb(87 187 255 / .2) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: linear-gradient(to bottom, black, transparent 72%);
  }

  .joinus-hero-media__surface::after {
    position: absolute;
    z-index: 0;
    top: 18%;
    left: 13%;
    width: 74%;
    aspect-ratio: 1;
    content: "";
    pointer-events: none;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(44 170 255 / .18), rgb(0 170 128 / .06) 48%, transparent 70%);
    filter: blur(10px);
    animation: joinus-ambient-orbit 8s ease-in-out infinite alternate;
  }

  .joinus-hero-media__code {
    position: absolute;
    top: 7%;
    left: 8%;
    z-index: 1;
    color: rgb(87 187 255 / .5);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(.65rem, 1.4vw, .82rem);
    font-weight: 700;
    letter-spacing: .1em;
  }


  .joinus-hero-media__photo {
    position: absolute;
    z-index: 2;
    left: 50%;
    bottom: 1%;
    display: block;
    width: auto;
    max-width: 96%;
    height: 98%;
    transform: translateX(-50%);
    filter: drop-shadow(0 18px 24px rgb(0 0 0 / .22));
    transition: transform 700ms cubic-bezier(.2, .8, .2, 1), filter 700ms ease;
  }

  .joinus-hero-media__frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .joinus-hero-media__frame--back {
    z-index: 1;
  }

  .joinus-hero-media__frame--front {
    z-index: 3;
  }

  @keyframes joinus-ambient-orbit {
    from { transform: translate3d(-4%, -2%, 0) scale(.92); opacity: .55; }
    to { transform: translate3d(5%, 4%, 0) scale(1.08); opacity: 1; }
  }

  @media (hover: hover) and (pointer: fine) {
    .joinus-hero-media__surface:hover .joinus-hero-media__photo {
      filter: drop-shadow(0 22px 30px rgb(0 0 0 / .28)) saturate(1.04);
      transform: translateX(-50%) scale(1.012);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .joinus-hero-media__photo,
    .joinus-hero-media__surface::after {
      animation: none;
      transition: none;
    }
  }
</style>
