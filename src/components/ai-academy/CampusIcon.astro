---
import { ACADEMY_ICONS, type AcademyIconName } from "~/lib/academy-icons";

interface Props {
  name: AcademyIconName;
  size?: number;
  fill?: boolean;
  class?: string;
}

const { name, size = 20, fill = false, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" width={size} height={size} fill={fill ? "currentColor" : "none"} stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ACADEMY_ICONS[name]} />
