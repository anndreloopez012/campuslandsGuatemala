---
import LayoutNavbar from "../../layouts/LayoutNavbar.astro";
import BlogCover from "../../components/blog/BlogCover.astro";
import {
  colorRgb,
  formatBlogDate,
  getBlogData,
  safeCategoryColor,
} from "../../lib/blog";
import { DEFAULT_IMAGE, SITE, SITE_URL } from "../../config/seo.mjs";
import "~/styles/index.css";

export const prerender = false;
Astro.response.headers.set("Cache-Control", "public, max-age=0, must-revalidate");

const { settings, categories, articles, galleries, source } = await getBlogData();
const latestBlogUpdate = [...articles, ...galleries]
  .map((entry) => entry.modifiedDate)
  .filter(Boolean)
  .sort()
  .at(-1);

const dataFooter = settings
  ? {
      title: settings.footerTitle,
      content: settings.footerDescription,
      buttonType: "contacto",
    }
  : undefined;

const structuredData = settings
  ? [
      {
        "@type": "Blog",
        "@id": `${SITE_URL}/blog/#blog`,
        url: `${SITE_URL}/blog/`,
        name: settings.publicationName,
        headline: settings.heroTitle,
        description: settings.seoDescription,
        dateModified: latestBlogUpdate,
        inLanguage: SITE.language,
        publisher: { "@id": `${SITE_URL}/#organization` },
        blogPost: articles.map((article) => ({
          "@type": "BlogPosting",
          "@id": `${SITE_URL}/blog/${article.slug}/#article`,
          headline: article.title,
          description: article.excerpt,
          datePublished: article.publishedDate || article.publishDate,
          dateModified: article.modifiedDate || article.publishDate,
          url: `${SITE_URL}/blog/${article.slug}/`,
          articleSection: article.category.name,
          keywords: article.tags.join(", "),
          author: {
            "@type": "Organization",
            name: article.authorName,
            url: `${SITE_URL}/nosotros/`,
          },
          publisher: { "@id": `${SITE_URL}/#organization` },
          mainEntityOfPage: { "@id": `${SITE_URL}/blog/${article.slug}/#webpage` },
          image: [article.coverImage?.url || DEFAULT_IMAGE],
        })),
      },
      {
        "@type": "ItemList",
        "@id": `${SITE_URL}/blog/#publicaciones`,
        name: settings.archiveTitle,
        numberOfItems: articles.length,
        itemListOrder: "https://schema.org/ItemListOrderDescending",
        itemListElement: articles.map((article, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: article.title,
          url: `${SITE_URL}/blog/${article.slug}/`,
        })),
      },
    ]
  : undefined;
---

<LayoutNavbar
  dataFooter={dataFooter}
  title={settings?.seoTitle}
  description={settings?.seoDescription}
  pageType="CollectionPage"
  modifiedTime={latestBlogUpdate}
  structuredData={structuredData}
>
  <div class="blog-index">
    <a class="sr-only" href="/galeria/">Explorar galerías de la comunidad Campuslands Guatemala</a>
    {settings ? (
      <>
        <header class="blog-toolbar sections">
          <div class="blog-toolbar__title">
            <span aria-hidden="true"></span>
            <h1>{settings.publicationName}</h1>
          </div>
          <p id="blog-result-count" aria-live="polite">{articles.length} publicaciones</p>
        </header>

        <p class="sr-only">{settings.heroTitle} {settings.heroDescription}</p>

        {categories.length > 0 && (
          <nav class="category-console sections" aria-label="Filtrar publicaciones por categoría">
            <div class="category-console__topline">
              <p><span aria-hidden="true">&gt;</span> {settings.filterLabel}</p>
            </div>
            <div class="category-console__rail" data-category-filters>
              <button class="category-chip is-active" type="button" data-category="all" aria-pressed="true">
                <span class="category-chip__signal"></span>
                {settings.allCategoriesLabel}
              </button>
              {categories.map((category) => (
                <button
                  class="category-chip"
                  type="button"
                  data-category={category.slug}
                  data-description={category.description}
                  aria-pressed="false"
                  style={`--category-color:${safeCategoryColor(category.color)};--category-rgb:${colorRgb(category.color)}`}
                >
                  <span class="category-chip__signal"></span>
                  {category.name}
                </button>
              ))}
              {galleries.length > 0 && (
                <a class="category-chip category-chip--gallery" href="/galeria/">
                  <span class="category-chip__signal"></span>
                  {settings.galleriesLabel} · {galleries.length}
                </a>
              )}
            </div>
            <p
              class="category-console__description"
              data-category-description
              data-default-description={settings.categoryIntro}
            >
              {settings.categoryIntro}
            </p>
          </nav>
        )}

        {articles.length > 0 && (
          <section class="catalog-controls sections" aria-label="Buscar y filtrar publicaciones">
            <label class="catalog-search">
              <span class="catalog-search__label">Buscar una nota</span>
              <span class="catalog-search__field">
                <svg aria-hidden="true" viewBox="0 0 24 24">
                  <circle cx="11" cy="11" r="6.5"></circle>
                  <path d="m16 16 4 4"></path>
                </svg>
                <input
                  type="search"
                  placeholder="Título, tema, autor o palabra clave"
                  autocomplete="off"
                  aria-controls="blog-story-grid"
                  data-blog-search
                />
                <button type="button" data-clear-search aria-label="Limpiar búsqueda" hidden>Limpiar</button>
              </span>
            </label>
            <div class="catalog-controls__status" aria-live="polite" aria-atomic="true" data-catalog-status>
              Mostrando publicaciones recientes
            </div>
          </section>
        )}

        <section class="story-feed sections" aria-label={settings.archiveTitle} data-story-feed>
          <div class="story-grid" id="blog-story-grid" data-story-grid>
            {articles.map((article, index) => (
              <article
                class:list={["story-card", { "story-card--featured": article.featured }]}
                data-article-card
                data-category={article.category.slug}
                data-search={`${article.title} ${article.excerpt} ${article.category.name} ${article.authorName} ${article.tags.join(" ")}`}
                style={`--category-color:${safeCategoryColor(article.category.color)};--category-rgb:${colorRgb(article.category.color)}`}
              >
                <a href={`/blog/${article.slug}/`} aria-label={`Leer ${article.title}`}>
                  <BlogCover article={article} variant="card" index={index + 1} />
                  <div class="story-card__body">
                    <div class="story-card__topline">
                      <div class="story-card__category"><span></span>{article.category.name}</div>
                      {article.featured && <em>{settings.featuredLabel}</em>}
                    </div>
                    <h2>{article.title}</h2>
                    <p>{article.excerpt}</p>
                    <div class="story-card__footer">
                      <span>{formatBlogDate(article.publishDate)}</span>
                      <span>{article.readingTime} min</span>
                    </div>
                  </div>
                </a>
              </article>
            ))}
          </div>

          <div class="story-empty" data-story-empty hidden={articles.length > 0}>
            <span aria-hidden="true">{`{ 00 }`}</span>
            <h2>{settings.emptyTitle}</h2>
            <p>{settings.emptyDescription}</p>
            <button type="button" data-reset-filter>{settings.emptyButtonLabel}</button>
          </div>

          <div class="story-pagination" data-story-pagination hidden>
            <button type="button" data-load-more aria-controls="blog-story-grid">
              <span>Cargar más</span>
              <small data-load-more-remaining></small>
              <svg aria-hidden="true" viewBox="0 0 24 24">
                <path d="M12 5v14M6 13l6 6 6-6"></path>
              </svg>
            </button>
          </div>
        </section>
      </>
    ) : (
      <section class="blog-service-state sections" aria-live="polite">
        <span>CMS / {source === "unavailable" ? "SIN CONEXIÓN" : "SIN CONFIGURAR"}</span>
        <h1>La publicación está temporalmente en preparación.</h1>
        <h2 class="sr-only">Artículos de tecnología, programación, inteligencia artificial y empleabilidad</h2>
        <p>El contenido editorial volverá a mostrarse cuando la administración esté disponible.</p>
      </section>
    )}
  </div>
</LayoutNavbar>

<script>
  function initializeBlogFilters() {
    const feed = document.querySelector<HTMLElement>("[data-story-feed]");
    if (!feed || feed.dataset.filtersReady === "true") return;
    feed.dataset.filtersReady = "true";

    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-category-filters] [data-category]"));
    const cards = Array.from(feed.querySelectorAll<HTMLElement>("[data-article-card]"));
    const count = document.querySelector<HTMLElement>("#blog-result-count");
    const description = document.querySelector<HTMLElement>("[data-category-description]");
    const empty = feed.querySelector<HTMLElement>("[data-story-empty]");
    const reset = feed.querySelector<HTMLButtonElement>("[data-reset-filter]");
    const search = document.querySelector<HTMLInputElement>("[data-blog-search]");
    const clearSearch = document.querySelector<HTMLButtonElement>("[data-clear-search]");
    const status = document.querySelector<HTMLElement>("[data-catalog-status]");
    const pagination = feed.querySelector<HTMLElement>("[data-story-pagination]");
    const loadMore = feed.querySelector<HTMLButtonElement>("[data-load-more]");
    const remainingLabel = feed.querySelector<HTMLElement>("[data-load-more-remaining]");
    const defaultDescription = description?.dataset.defaultDescription || "";
    const pageSize = 4;
    let activeCategory = "all";
    let query = "";
    let visibleLimit = pageSize;

    if (!cards.length) return;

    const normalize = (value: string) => value
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLocaleLowerCase("es");

    const updateUrl = () => {
      const url = new URL(window.location.href);
      if (activeCategory === "all") url.searchParams.delete("categoria");
      else url.searchParams.set("categoria", activeCategory);
      if (query) url.searchParams.set("buscar", query);
      else url.searchParams.delete("buscar");
      history.replaceState({}, "", url);
    };

    const render = (syncUrl = true) => {
      const normalizedQuery = normalize(query.trim());
      const matchingCards = cards.filter((card) => {
        const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
        const matchesSearch = !normalizedQuery || normalize(card.dataset.search || "").includes(normalizedQuery);
        return matchesCategory && matchesSearch;
      });

      cards.forEach((card) => { card.hidden = true; });
      matchingCards.slice(0, visibleLimit).forEach((card) => { card.hidden = false; });

      const shown = Math.min(visibleLimit, matchingCards.length);
      const remaining = Math.max(matchingCards.length - shown, 0);
      const noun = matchingCards.length === 1 ? "publicación" : "publicaciones";

      filters.forEach((filter) => {
        const active = filter.dataset.category === activeCategory;
        filter.classList.toggle("is-active", active);
        filter.setAttribute("aria-pressed", String(active));
      });

      const selected = filters.find((filter) => filter.dataset.category === activeCategory);
      if (count) count.textContent = `${matchingCards.length} ${noun}`;
      if (status) status.textContent = matchingCards.length
        ? `Mostrando ${shown} de ${matchingCards.length} ${noun}`
        : "No encontramos publicaciones con esos filtros";
      if (description) description.textContent = activeCategory === "all" ? defaultDescription : selected?.dataset.description || "";
      if (empty) empty.hidden = matchingCards.length > 0;
      if (pagination) pagination.hidden = remaining === 0;
      if (remainingLabel) remainingLabel.textContent = remaining ? `${remaining} por descubrir` : "";
      if (clearSearch) clearSearch.hidden = !query;
      if (syncUrl) updateUrl();
    };

    const selectCategory = (category: string) => {
      activeCategory = category;
      visibleLimit = pageSize;
      render();
    };

    filters.forEach((filter) => filter.addEventListener("click", () => selectCategory(filter.dataset.category || "all")));

    search?.addEventListener("input", () => {
      query = search.value;
      visibleLimit = pageSize;
      render();
    });

    clearSearch?.addEventListener("click", () => {
      if (!search) return;
      search.value = "";
      query = "";
      visibleLimit = pageSize;
      render();
      search.focus();
    });

    reset?.addEventListener("click", () => {
      activeCategory = "all";
      query = "";
      visibleLimit = pageSize;
      if (search) search.value = "";
      render();
    });

    loadMore?.addEventListener("click", () => {
      const previouslyVisible = new Set(cards.filter((card) => !card.hidden));
      visibleLimit += pageSize;
      render(false);

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        cards.filter((card) => !card.hidden && !previouslyVisible.has(card)).forEach((card, index) => {
          card.animate(
            [
              { opacity: 0, transform: "translateY(18px) scale(.985)" },
              { opacity: 1, transform: "translateY(0) scale(1)" },
            ],
            { duration: 420, delay: index * 55, easing: "cubic-bezier(.16,1,.3,1)", fill: "backwards" },
          );
        });
      }
    });

    const params = new URLSearchParams(window.location.search);
    const requestedCategory = params.get("categoria") || "all";
    activeCategory = filters.some((filter) => filter.dataset.category === requestedCategory) ? requestedCategory : "all";
    query = params.get("buscar") || "";
    if (search) search.value = query;
    render(false);
  }

  document.addEventListener("DOMContentLoaded", initializeBlogFilters);
  document.addEventListener("astro:page-load", initializeBlogFilters);
</script>

<style>
  .blog-index {
    --blog-max: 1320px;
    position: relative;
    padding-bottom: 2rem;
  }

  .blog-index::before {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 24rem;
    background:
      radial-gradient(circle at 82% 4%, rgb(122 60 255 / 13%), transparent 25%),
      radial-gradient(circle at 10% 18%, rgb(44 170 255 / 12%), transparent 27%);
    content: "";
    pointer-events: none;
  }

  .blog-toolbar {
    display: flex;
    max-width: var(--blog-max);
    margin: 0 auto;
    padding-top: 1.35rem;
    padding-bottom: 0.85rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid rgb(87 187 255 / 20%);
  }

  .blog-toolbar__title {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .blog-toolbar__title h1 {
    margin: 0;
    color: #8cd1ff;
    font: 700 0.78rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .blog-toolbar__title span {
    width: 0.52rem;
    height: 0.52rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #00d9a4;
    box-shadow: 0 0 0 0.35rem rgb(0 217 164 / 9%), 0 0 0.85rem #00d9a4;
  }

  .blog-toolbar > p {
    color: rgb(255 255 255 / 45%);
    font: 600 0.67rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-console {
    max-width: var(--blog-max);
    margin: 0 auto;
    padding-top: 0.85rem;
    padding-bottom: 0.35rem;
  }

  .category-console__topline {
    display: flex;
    margin-bottom: 0.65rem;
    align-items: center;
    gap: 1rem;
    color: rgb(255 255 255 / 46%);
    font: 600 0.67rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .category-console__topline p:first-child span { color: #00d9a4; }

  .category-console__rail {
    display: flex;
    gap: 0.6rem;
    padding: 0.2rem 0 0.45rem;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .category-chip {
    --category-color: #57bbff;
    --category-rgb: 87 187 255;
    display: inline-flex;
    flex: 0 0 auto;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    align-items: center;
    gap: 0.6rem;
    border: 1px solid rgb(var(--category-rgb) / 26%);
    border-radius: 999px;
    color: rgb(255 255 255 / 66%);
    background: rgb(255 255 255 / 3%);
    font-size: 0.8rem;
    transition: 180ms ease;
  }
  .category-chip--gallery { --category-color: #00d9a4; --category-rgb: 0 217 164; text-decoration: none; }

  .category-chip:hover,
  .category-chip.is-active {
    border-color: rgb(var(--category-rgb) / 78%);
    color: white;
    background: rgb(var(--category-rgb) / 14%);
    box-shadow: inset 0 0 1.2rem rgb(var(--category-rgb) / 8%);
  }

  .category-chip:focus-visible { outline: 2px solid var(--category-color); outline-offset: 3px; }
  .category-chip__signal { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--category-color); box-shadow: 0 0 0.8rem var(--category-color); }
  .category-console__description { min-height: 1.2rem; margin-top: 0.35rem; color: rgb(255 255 255 / 50%); font-size: 0.76rem; }

  .catalog-controls {
    display: grid;
    max-width: var(--blog-max);
    margin: 0.55rem auto 0;
    grid-template-columns: minmax(16rem, 34rem) 1fr;
    align-items: end;
    gap: 1rem;
  }

  .catalog-search { display: grid; gap: 0.45rem; }

  .catalog-search__label {
    color: #8cd1ff;
    font: 650 0.62rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .catalog-search__field {
    display: flex;
    min-height: 3rem;
    padding: 0 0.45rem 0 0.9rem;
    align-items: center;
    gap: 0.65rem;
    border: 1px solid rgb(87 187 255 / 25%);
    border-radius: 1rem;
    background: rgb(4 13 40 / 72%);
    box-shadow: inset 0 0 1.5rem rgb(87 187 255 / 3%);
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  .catalog-search__field:focus-within {
    border-color: rgb(87 187 255 / 72%);
    box-shadow: 0 0 0 3px rgb(87 187 255 / 9%), inset 0 0 1.5rem rgb(87 187 255 / 6%);
  }

  .catalog-search__field svg {
    width: 1.05rem;
    height: 1.05rem;
    flex: 0 0 auto;
    fill: none;
    stroke: #57bbff;
    stroke-linecap: round;
    stroke-width: 1.6;
  }

  .catalog-search input {
    width: 100%;
    min-width: 0;
    border: 0;
    outline: 0;
    color: white;
    background: transparent;
    font: inherit;
    font-size: 0.82rem;
  }

  .catalog-search input::placeholder { color: rgb(255 255 255 / 38%); }
  .catalog-search input::-webkit-search-cancel-button { display: none; }

  .catalog-search button {
    width: auto;
    height: auto;
    min-height: 2rem;
    padding: 0.45rem 0.65rem;
    border: 0;
    border-radius: 0.65rem;
    color: #8cd1ff;
    background: rgb(87 187 255 / 10%);
    font-size: 0.64rem;
  }

  .catalog-search button:hover { color: white; background: rgb(87 187 255 / 18%); }
  .catalog-search button:focus-visible { outline: 2px solid #57bbff; outline-offset: 2px; }
  .catalog-controls__status { padding-bottom: 0.85rem; color: rgb(255 255 255 / 45%); font: 600 0.65rem/1.4 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: 0.04em; text-align: right; text-transform: uppercase; }

  .story-feed {
    max-width: var(--blog-max);
    margin: 0.9rem auto 0;
  }

  .story-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }

  .story-card {
    position: relative;
    min-width: 0;
    border: 1px solid rgb(var(--category-rgb) / 20%);
    border-radius: 1.5rem;
    background: linear-gradient(180deg, rgb(var(--category-rgb) / 5%), rgb(7 16 43 / 68%));
    transition: border-color 240ms ease, transform 300ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 300ms ease;
  }

  .story-card--featured { border-color: rgb(var(--category-rgb) / 42%); }
  .story-card[hidden] { display: none; }
  .story-card:hover { border-color: rgb(var(--category-rgb) / 58%); transform: translateY(-0.4rem); box-shadow: 0 1.4rem 3.2rem rgb(0 0 30 / 30%); }
  .story-card > a { display: block; height: 100%; padding: 0.5rem; color: inherit; text-decoration: none; }
  .story-card > a:focus-visible { outline: 2px solid var(--category-color); outline-offset: 4px; border-radius: 1.2rem; }
  :global(.story-card .blog-cover--card) { min-height: 13.25rem; }

  .story-card__body { display: flex; min-height: 15.5rem; padding: 1.05rem 0.85rem 0.9rem; flex-direction: column; }
  .story-card__topline { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 0.45rem; }
  .story-card__category { display: flex; min-width: 0; align-items: center; gap: 0.45rem; color: var(--category-color); font: 600 0.59rem/1 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; letter-spacing: 0.065em; text-transform: uppercase; }
  .story-card__category span { width: 0.9rem; height: 1px; flex: 0 0 auto; background: var(--category-color); box-shadow: 0 0 0.55rem var(--category-color); }
  .story-card__topline em { flex: 0 0 auto; padding: 0.27rem 0.4rem; border: 1px solid rgb(var(--category-rgb) / 38%); border-radius: 999px; color: rgb(255 255 255 / 64%); font: 600 0.45rem/1 ui-monospace, monospace; font-style: normal; letter-spacing: 0.06em; text-transform: uppercase; }
  .story-card h2 { margin-top: 0.9rem; color: white; font-size: clamp(1.05rem, 1.7vw, 1.3rem); font-weight: 700; line-height: 1.2; letter-spacing: -0.025em; }
  .story-card__body > p { display: -webkit-box; margin-top: 0.7rem; overflow: hidden; color: rgb(255 255 255 / 54%); font-size: 0.76rem; line-height: 1.58; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .story-card__footer { display: flex; margin-top: auto; padding-top: 1.1rem; justify-content: space-between; gap: 0.75rem; color: rgb(255 255 255 / 38%); font-size: 0.61rem; }

  .story-empty { padding: 4rem 1.5rem; border: 1px dashed rgb(87 187 255 / 30%); border-radius: 1.5rem; text-align: center; }
  .story-empty span { color: #57bbff; font-family: monospace; font-size: 2rem; }
  .story-empty h2 { margin-top: 0.8rem; color: white; font-size: 1.5rem; }
  .story-empty p { margin: 0.65rem auto 0; max-width: 34rem; color: rgb(255 255 255 / 58%); }
  .story-empty button { min-height: 2.75rem; margin-top: 1.4rem; padding: 0.7rem 1.1rem; border-radius: 999px; color: #07102b; background: #00d9a4; font-weight: 700; }

  .story-pagination { display: flex; padding: 2.1rem 0 0.75rem; justify-content: center; }
  .story-pagination[hidden] { display: none; }

  .story-pagination button {
    display: grid;
    width: min(100%, 20rem);
    height: auto;
    min-height: 3.6rem;
    padding: 0.75rem 1rem 0.75rem 1.25rem;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 0.8rem;
    border: 1px solid rgb(87 187 255 / 42%);
    border-radius: 1rem;
    color: white;
    background: linear-gradient(135deg, rgb(87 187 255 / 13%), rgb(0 217 164 / 8%));
    box-shadow: 0 1rem 2.8rem rgb(0 0 30 / 18%);
    text-align: left;
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .story-pagination button:hover { border-color: #57bbff; transform: translateY(-0.2rem); box-shadow: 0 1.2rem 3rem rgb(24 134 255 / 18%); }
