---
export const prerender = false;

import LayoutNavbar from "~/layouts/LayoutNavbar.astro";
import CampusIcon from "~/components/ai-academy/CampusIcon.astro";
import DiplomaReplica from "~/components/ai-academy/DiplomaReplica.astro";
import { AI_ACADEMY_WHATSAPP } from "~/content/aiAcademy";
import { SITE_URL } from "~/config/seo.mjs";
import {
  campusData, campusFileUrl, embedUrl, formatDiplomaDate, formatDuration, linkedinAddUrl, linkedinShareUrl,
  type CampusVideo, type CampusWorkshop,
} from "~/lib/academy-campus";
import "~/styles/index.css";
import "~/styles/ai-academy-tema.css";
import "~/styles/ai-academy-campus.css";

const data = await campusData(Astro.cookies);
if (!data) return Astro.redirect("/ai-academy/acceso/", 302);
if (data.student.mustChangePassword) return Astro.redirect("/ai-academy/campus/clave/", 302);

const { student, workshops } = data;
const firstName = student.fullName.split(" ")[0];
const requested = Astro.url.searchParams.get("taller");
const current = workshops.find((item) => item.key === requested) ?? workshops[0];
const welcome = Astro.url.searchParams.has("bienvenida");

// El avance lo define el administrador moviendo la sesión del bloque (sábado 2 de 4 = 50 %).
const progressOf = (item: CampusWorkshop) => item.block?.progress ?? 0;
const block = current?.block ?? null;
const blockStatus = !block ? "" : block.status === "finalizado" ? "Finalizado" : block.status === "por-iniciar" ? "Por iniciar" : `Sábado ${block.currentSession} de ${block.totalSessions}`;
const verifyUrl = (id: string) => `${SITE_URL}/ai-academy/diploma/${id}/`;
const favicon = (url: string) => {
  try { return `https://www.google.com/s2/favicons?sz=64&domain=${new URL(url).hostname}`; } catch { return ""; }
};
const host = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/.*$/, "");

// Primero las clases por sábado; el material complementario (sin sábado) va al final.
const videos = [...(current?.videos ?? [])].sort((a, b) => (a.session ?? 99) - (b.session ?? 99));
// Solo los videos de sábados ya alcanzados se reproducen; los demás aparecen con candado.
const open = videos.filter((video) => !video.locked);
const sessions = [...videos.reduce((map, video) => {
  const label = video.session ? `Sábado ${video.session}` : "Material complementario";
  map.set(label, [...(map.get(label) ?? []), { video, index: open.indexOf(video) }]);
  return map;
}, new Map<string, { video: CampusVideo; index: number }[]>())];
const nextLocked = videos.find((video) => video.locked)?.session ?? null;
const resumeIndex = Math.max(0, open.findIndex((video) => !video.progress.completed));
const categories = [...new Set((current?.tools ?? []).map((tool) => tool.category).filter(Boolean))];
const defaultTab = current?.diplomas.length ? "diplomas" : open.length ? "videos" : "herramientas";

const playerData = open.map((video) => ({
  id: video.id,
  title: video.title,
  description: video.description,
  kind: video.source === "enlace" ? (embedUrl(video.externalUrl) ? "embed" : "externo") : "archivo",
  src: video.source === "enlace" ? embedUrl(video.externalUrl) || video.externalUrl : video.file ? campusFileUrl(video.file) : "",
  seconds: video.progress.seconds,
  completed: video.progress.completed,
}));

const help = `https://wa.me/${AI_ACADEMY_WHATSAPP}?text=${encodeURIComponent("¡Hola! Soy estudiante de AI Academy y tengo una consulta sobre mi campus.")}`;
---

<LayoutNavbar dataFooter={{ title: "¿Dudas con tu campus?", content: "Escríbenos y te respondemos el mismo día.", buttonType: "ia", buttonLink: help }} title={`Campus de ${firstName} | AI Academy`} description="Tu campus de AI Academy." noindex>
  <section class="cx campus" style={`--cx-accent: ${current?.accent ?? "#7a3cff"};`} data-campus data-welcome={welcome ? "1" : undefined}>
    <div class="cx-sky" aria-hidden="true"></div>

    <div class="cx-shell">
      <header class="campus__top">
        <div>
          <p class="cx-kicker"><i></i>Campus AI Academy</p>
          <h1>Hola, <span>{firstName}</span>.</h1>
          <p class="campus__sub">{workshops.length === 1 ? "Este es tu taller." : workshops.length ? `Tienes ${workshops.length} talleres en tu órbita.` : "Tu campus está listo."}</p>
        </div>
        <div class="campus__me">
          <span class="campus__avatar" aria-hidden="true">{student.fullName.split(/\s+/).slice(0, 2).map((part) => part[0]).join("").toUpperCase()}</span>
          <span class="campus__who"><strong>{student.fullName}</strong><small>{student.email}</small></span>
          <a class="cx-btn cx-btn--ghost cx-btn--small" href="/ai-academy/campus/clave/">Contraseña</a>
          <form method="post" action="/ai-academy/campus/salir/"><button class="cx-btn cx-btn--ghost cx-btn--small" type="submit">Salir</button></form>
        </div>
      </header>

      {!current ? (
        <div class="cx-glass campus__empty">
          <span aria-hidden="true"><CampusIcon name="orbita" size={30} /></span>
          <h2>Aún no estás inscrito en un taller</h2>
          <p>Cuando el equipo te inscriba, aquí aparecerán tus diplomas, herramientas y videos.</p>
          <a class="cx-btn" href={help} target="_blank" rel="noopener noreferrer">Escribir al equipo ↗</a>
        </div>
      ) : (
        <>
          {workshops.length > 1 && (
            <nav class="campus__switch" aria-label="Mis talleres">
              {workshops.map((item) => {
                const pct = progressOf(item);
                return (
                  <a href={`/ai-academy/campus/?taller=${item.key}`} class:list={["campus__pill", item.key === current.key && "is-active"]} style={`--cx-accent: ${item.accent};`} aria-current={item.key === current.key ? "page" : undefined}>
                    <span class="campus__ring" style={`--pct: ${pct}`} aria-hidden="true"><b>{pct}%</b></span>
                    <span><small>{item.code}</small><strong>{item.title}</strong></span>
                  </a>
                );
              })}
            </nav>
          )}

          <article class="campus__hero cx-glass">
            <span class="campus__orb" aria-hidden="true"></span>
            <div class="campus__hero-copy">
              <div class="campus__chips">
                <span class="campus__code">{current.code}</span>
                {block && <span class="campus__chip">{block.name}</span>}
                {block && <span class:list={["campus__chip", block.status === "finalizado" && "is-ok"]}>{blockStatus}</span>}
              </div>
              <h2>{current.title}</h2>
              {current.description && <p>{current.description}</p>}
            </div>
            <div class="campus__progress">
              <span class="campus__ring campus__ring--big" style={`--pct: ${progressOf(current)}`}><b>{progressOf(current)}%</b></span>
              <dl>
                <div><dt>{current.diplomas.length}</dt><dd>diploma{current.diplomas.length === 1 ? "" : "s"}</dd></div>
                <div><dt>{current.tools.length}</dt><dd>herramientas</dd></div>
                <div><dt>{open.filter((video) => video.progress.completed).length}/{open.length}</dt><dd>videos vistos</dd></div>
              </dl>
            </div>
            {block && (
              <ol class="campus__route" aria-label="Avance de tu bloque">
                {Array.from({ length: block.totalSessions }, (_, i) => i + 1).map((number) => (
                  <li class:list={[number <= block.currentSession && "is-done", number === block.currentSession && "is-now"]}>
                    <span>{number <= block.currentSession ? <CampusIcon name="check" size={13} /> : number === block.currentSession + 1 ? number : <CampusIcon name="candado" size={12} />}</span>
                    <small>Sábado {number}</small>
                  </li>
                ))}
              </ol>
            )}
          </article>

          <div class="campus__tabs" role="tablist" aria-label="Secciones del taller" data-tabs data-default={defaultTab}>
            <button type="button" role="tab" data-tab="diplomas"><span aria-hidden="true"><CampusIcon name="diploma" size={18} /></span>Diplomas<i>{current.diplomas.length}</i></button>
            <button type="button" role="tab" data-tab="herramientas"><span aria-hidden="true"><CampusIcon name="herramienta" size={17} /></span>Herramientas<i>{current.tools.length}</i></button>
            <button type="button" role="tab" data-tab="videos"><span aria-hidden="true"><CampusIcon name="video" size={18} /></span>Videos<i>{videos.length}</i></button>
          </div>

          <!-- DIPLOMAS -->
          <section class="campus__panel" role="tabpanel" data-panel="diplomas" aria-label="Diplomas">
            {current.diplomas.length ? current.diplomas.map((diploma) => {
              const url = verifyUrl(diploma.credentialId);
              return (
                <div class="campus__diploma">
                  <DiplomaReplica fullName={student.fullName} title={diploma.title} hours={diploma.hours} issuedAt={diploma.issuedAt} credentialId={diploma.credentialId} verifyUrl={url} design={diploma.design} />
                  {diploma.skills.length > 0 && <ul class="cx-skills campus__skills">{diploma.skills.map((skill) => <li>{skill}</li>)}</ul>}
                  <div class="campus__diploma-actions">
                    <a class="cx-btn cx-btn--linkedin" href={linkedinAddUrl(diploma, url)} target="_blank" rel="noopener noreferrer">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.95v5.66H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
                      Agregar a mi perfil de LinkedIn
                    </a>
                    <a class="cx-btn cx-btn--ghost" href={linkedinShareUrl(url)} target="_blank" rel="noopener noreferrer">Compartir publicación</a>
                    {diploma.file && <a class="cx-btn cx-btn--ghost" href={campusFileUrl(diploma.file, true)} download>Descargar PDF ↓</a>}
                    {diploma.file && <a class="cx-btn cx-btn--ghost" href={campusFileUrl(diploma.file)} target="_blank" rel="noopener">Ver PDF</a>}
                    <button type="button" class="cx-btn cx-btn--ghost" data-copy={url}>Copiar enlace de verificación</button>
                    <a class="campus__verify" href={url} target="_blank" rel="noopener">Ver página de verificación ↗</a>
                  </div>
                </div>
              );
            }) : (
              <div class="cx-glass campus__locked">
                <span class="campus__lock" aria-hidden="true"><CampusIcon name="candado" size={28} /></span>
                <h3>Tu diploma se desbloquea al terminar el taller</h3>
                <p>Cuando el equipo lo emita aparecerá aquí, con su identificador verificable y el botón para agregarlo a LinkedIn.</p>
                <div class="campus__lock-bar" aria-hidden="true"><i style={`width: ${Math.max(6, progressOf(current))}%`}></i></div>
              </div>
            )}
          </section>

          <!-- HERRAMIENTAS -->
          <section class="campus__panel" role="tabpanel" data-panel="herramientas" aria-label="Herramientas" hidden>
            {current.tools.length ? (
              <>
                <div class="campus__tool-bar">
                  <label class="cx-field campus__search"><span class="sr-only">Buscar herramienta</span><input type="search" placeholder="Buscar herramienta…" data-tool-search /></label>
                  {categories.length > 1 && (
                    <div class="campus__cats" data-cats>
                      <button type="button" class="is-active" data-cat="">Todas</button>
                      {categories.map((category) => <button type="button" data-cat={category}>{category}</button>)}
                    </div>
                  )}
                </div>
                <div class="campus__tools">
                  {current.tools.map((tool) => (
                    <a class="campus__tool" href={tool.url} target="_blank" rel="noopener noreferrer" data-tool={`${tool.title} ${tool.description} ${tool.category}`.toLowerCase()} data-tool-cat={tool.category}>
                      {favicon(tool.url) && <img src={favicon(tool.url)} alt="" width="44" height="44" loading="lazy" />}
                      <span class="campus__tool-body">
                        <strong>{tool.title}</strong>
                        <small>{host(tool.url)}</small>
                        {tool.description && <span>{tool.description}</span>}
                      </span>
                      <span class="campus__tool-go" aria-hidden="true">↗</span>
                      {tool.category && <span class="campus__tool-cat">{tool.category}</span>}
                    </a>
                  ))}
                </div>
                <p class="campus__none" hidden data-tools-empty>Ninguna herramienta coincide con tu búsqueda.</p>
              </>
            ) : (
              <div class="cx-glass campus__locked"><span class="campus__lock" aria-hidden="true"><CampusIcon name="herramienta" size={28} /></span><h3>Pronto verás aquí tus herramientas</h3><p>El equipo publicará los enlaces y recursos del taller.</p></div>
            )}
          </section>

          <!-- VIDEOS -->
          <section class="campus__panel" role="tabpanel" data-panel="videos" aria-label="Videos" hidden>
            {open.length ? (
              <div class="campus__cinema">
                <div class="campus__stage">
                  <div class="campus__screen" data-screen>
                    <video controls playsinline preload="metadata" controlslist="nodownload" data-player hidden></video>
                    <iframe title="Video del taller" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen data-embed hidden></iframe>
                    <a class="campus__external" target="_blank" rel="noopener noreferrer" data-external hidden>Abrir el video en una pestaña nueva ↗</a>
                  </div>
                  <div class="campus__now">
                    <div>
                      <p class="cx-kicker"><i></i><span data-now-label>Reproduciendo</span></p>
                      <h3 data-now-title></h3>
                      <p data-now-desc></p>
                    </div>
                    <button type="button" class="cx-btn cx-btn--ghost cx-btn--small" data-mark><CampusIcon name="check" size={16} />Marcar como visto</button>
                  </div>
                </div>
                <aside class="campus__playlist" aria-label="Lista de videos">
                  {sessions.map(([label, items]) => (
                    <div class="campus__session">
                      <p class="campus__session-label">{label}</p>
                      {items.map(({ video, index }) => video.locked ? (
                        <div class="campus__item is-locked" title={`Se habilita cuando tu bloque llegue al Sábado ${video.session}`}>
                          <span class="campus__item-state"><CampusIcon name="candado" size={14} /></span>
                          <span class="campus__item-body">
                            <strong>{video.title}</strong>
                            <small>Se habilita en el Sábado {video.session}</small>
                          </span>
                        </div>
                      ) : (
                        <button type="button" class:list={["campus__item", video.progress.completed && "is-done"]} data-video-index={index} aria-label={`Reproducir ${video.title}`}>
                          <span class="campus__item-state"><CampusIcon name="play" size={14} fill class="is-play" /><CampusIcon name="check" size={16} class="is-check" /></span>
                          <span class="campus__item-body">
                            <strong>{video.title}</strong>
                            <small>{video.source === "enlace" ? "Enlace" : "Video"}{video.durationSeconds ? ` · ${formatDuration(video.durationSeconds)}` : ""}</small>
                            <span class="campus__item-bar"><i style={`width: ${video.progress.completed ? 100 : video.durationSeconds ? Math.min(100, Math.round((video.progress.seconds / video.durationSeconds) * 100)) : 0}%`}></i></span>
                          </span>
                        </button>
                      ))}
                    </div>
                  ))}
                </aside>
              </div>
            ) : (
              <div class="cx-glass campus__locked">
                <span class="campus__lock" aria-hidden="true"><CampusIcon name={nextLocked ? "candado" : "video"} size={28} /></span>
                <h3>{nextLocked ? `Tus clases se habilitan cada sábado` : "Las clases grabadas llegarán pronto"}</h3>
                <p>{nextLocked ? `La próxima se abre cuando tu bloque llegue al Sábado ${nextLocked}.` : "Cuando el equipo publique los videos de cada sábado, los verás aquí."}</p>
              </div>
            )}
          </section>
          <script type="application/json" data-videos set:html={JSON.stringify({ videos: playerData, resume: resumeIndex })} />
        </>
      )}
    </div>
    <p class="campus__toast" role="status" aria-live="polite"><CampusIcon name="check" size={16} /><span data-toast></span></p>
    <div class="campus__confetti" aria-hidden="true" data-confetti></div>
  </section>
</LayoutNavbar>

<script>
  type PlayerVideo = { id: number; title: string; description: string; kind: "archivo" | "embed" | "externo"; src: string; seconds: number; completed: boolean };

  function initCampus() {
    const root = document.querySelector<HTMLElement>("[data-campus]");
    if (!root) return;
    const toast = root.querySelector<HTMLElement>("[data-toast]");
    const say = (message: string) => {
      if (!toast) return;
      toast.textContent = message;
      toast.parentElement?.classList.add("is-visible");
      window.setTimeout(() => toast.parentElement?.classList.remove("is-visible"), 2600);
    };

    // Pestañas (recuerdan la última en la URL)
    const tabs = root.querySelector<HTMLElement>("[data-tabs]");
    const show = (name: string, remember = true) => {
      root.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => { panel.hidden = panel.dataset.panel !== name; });
      tabs?.querySelectorAll<HTMLButtonElement>("[data-tab]").forEach((button) => button.setAttribute("aria-selected", String(button.dataset.tab === name)));
      if (remember) history.replaceState(history.state, "", `${location.pathname}${location.search}#${name}`);
    };
    tabs?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-tab]");
      if (button?.dataset.tab) show(button.dataset.tab);
    });
    const initial = location.hash.slice(1);
    show(["diplomas", "herramientas", "videos"].includes(initial) ? initial : tabs?.dataset.default || "diplomas", false);

    // Copiar enlace de verificación
    root.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => button.addEventListener("click", async () => {
      try { await navigator.clipboard.writeText(button.dataset.copy || ""); say("Enlace de verificación copiado."); }
      catch { window.prompt("Copia el enlace:", button.dataset.copy || ""); }
    }));

    // Herramientas: búsqueda y categorías
    const search = root.querySelector<HTMLInputElement>("[data-tool-search]");
    let category = "";
    const filterTools = () => {
      const query = (search?.value || "").trim().toLowerCase();
      let visible = 0;
      root.querySelectorAll<HTMLElement>("[data-tool]").forEach((tool) => {
        const match = (!query || (tool.dataset.tool || "").includes(query)) && (!category || tool.dataset.toolCat === category);
        tool.hidden = !match;
        if (match) visible += 1;
      });
      const empty = root.querySelector<HTMLElement>("[data-tools-empty]");
      if (empty) empty.hidden = visible > 0;
    };
    search?.addEventListener("input", filterTools);
    root.querySelector("[data-cats]")?.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-cat]");
      if (!button) return;
      category = button.dataset.cat || "";
      root.querySelectorAll("[data-cat]").forEach((item) => item.classList.toggle("is-active", item === button));
      filterTools();
    });

    // Reproductor
    const payload = root.querySelector<HTMLScriptElement>("[data-videos]");
    const parsed = payload ? JSON.parse(payload.textContent || "{}") : { videos: [], resume: 0 };
    const list: PlayerVideo[] = parsed.videos ?? [];
    const player = root.querySelector<HTMLVideoElement>("[data-player]");
    const embed = root.querySelector<HTMLIFrameElement>("[data-embed]");
    const external = root.querySelector<HTMLAnchorElement>("[data-external]");
    const mark = root.querySelector<HTMLButtonElement>("[data-mark]");
    let current = -1;
    let lastSaved = 0;

    const save = (completed = false) => {
      const video = list[current];
      if (!video) return;
      const seconds = player && !player.hidden ? player.currentTime : video.seconds;
      if (completed) video.completed = true;
      video.seconds = seconds;
      const body = JSON.stringify({ videoId: video.id, seconds, completed: video.completed });
      if (navigator.sendBeacon && document.visibilityState === "hidden") navigator.sendBeacon("/ai-academy/campus/progreso/", new Blob([body], { type: "application/json" }));
      else void fetch("/ai-academy/campus/progreso/", { method: "POST", headers: { "Content-Type": "application/json" }, body, keepalive: true });
    };

    const paintItem = (index: number) => {
      const item = root.querySelector<HTMLElement>(`[data-video-index="${index}"]`);
      const video = list[index];
      if (!item || !video) return;
      item.classList.toggle("is-done", video.completed);
    };

    const play = (index: number, autoplay = false) => {
      const video = list[index];
      if (!video || !player || !embed || !external) return;
      if (current >= 0 && current !== index) save();
      current = index;
      root.querySelectorAll<HTMLElement>("[data-video-index]").forEach((item) => item.classList.toggle("is-current", Number(item.dataset.videoIndex) === index));
      root.querySelector("[data-now-title]")!.textContent = video.title;
      root.querySelector("[data-now-desc]")!.textContent = video.description;
      root.querySelector("[data-now-label]")!.textContent = video.completed ? "Ya lo viste" : video.seconds > 5 ? "Continúa donde quedaste" : "Reproduciendo";
      player.hidden = video.kind !== "archivo";
      embed.hidden = video.kind !== "embed";
      external.hidden = video.kind !== "externo";
      player.pause();
      if (video.kind === "archivo") {
        player.src = video.src;
        player.addEventListener("loadedmetadata", () => {
          if (video.seconds > 5 && !video.completed && video.seconds < player.duration - 5) player.currentTime = video.seconds;
          if (autoplay) void player.play().catch(() => {});
        }, { once: true });
      } else if (video.kind === "embed") {
        embed.src = video.src;
        player.removeAttribute("src");
      } else {
        external.href = video.src;
      }
      if (mark) mark.hidden = video.completed;
    };

    player?.addEventListener("timeupdate", () => {
      const video = list[current];
      if (!video || !player.duration) return;
      if (!video.completed && player.currentTime / player.duration >= 0.9) {
        save(true);
        paintItem(current);
        if (mark) mark.hidden = true;
        say("¡Video completado!");
      } else if (Math.abs(player.currentTime - lastSaved) >= 15) {
        lastSaved = player.currentTime;
        save();
      }
    });
    player?.addEventListener("pause", () => save());
    document.addEventListener("visibilitychange", () => { if (document.visibilityState === "hidden") save(); });
    mark?.addEventListener("click", () => {
      save(true);
      paintItem(current);
      mark.hidden = true;
      say("Marcado como visto.");
    });
    root.querySelectorAll<HTMLButtonElement>("[data-video-index]").forEach((button) => button.addEventListener("click", () => play(Number(button.dataset.videoIndex), true)));
    if (list.length) play(Math.min(parsed.resume ?? 0, list.length - 1));

    // Bienvenida después de crear la contraseña
    const confetti = root.querySelector<HTMLElement>("[data-confetti]");
    if (root.dataset.welcome && confetti && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const colors = ["#57bbff", "#b997ff", "#7fffdc", "#ffc56b", "#ff7ad9"];
      for (let index = 0; index < 60; index += 1) {
        const piece = document.createElement("i");
        piece.style.left = `${Math.random() * 100}%`;
        piece.style.background = colors[index % colors.length];
        piece.style.animationDelay = `${Math.random() * 0.6}s`;
        piece.style.setProperty("--x", `${(Math.random() - 0.5) * 240}px`);
        piece.style.setProperty("--r", `${Math.random() * 720}deg`);
        confetti.append(piece);
      }
      window.setTimeout(() => confetti.replaceChildren(), 3600);
      say("¡Listo! Tu contraseña quedó guardada.");
      history.replaceState(history.state, "", location.pathname + location.hash);
    }
  }

