  @keyframes ai-distinct-pulse {
    0%,
    100% {
      border-color: rgb(0 217 164 / 34%);
      box-shadow: inset 0 0 14px rgb(0 217 164 / 8%);
    }

    50% {
      border-color: rgb(127 255 220 / 70%);
      box-shadow:
        inset 0 0 14px rgb(0 217 164 / 16%),
        0 0 16px rgb(0 217 164 / 14%);
    }
  }

  .ai-orbit {
    --orbit-pointer-x: 68%;
    --orbit-pointer-y: 30%;
    position: relative;
    width: min(100%, 34rem);
    aspect-ratio: 0.82;
    margin-inline: auto;
  }

  .ai-orbit::before {
    position: absolute;
    top: var(--orbit-pointer-y);
    left: var(--orbit-pointer-x);
    width: 12rem;
    aspect-ratio: 1;
    border-radius: 50%;
    content: "";
    background: radial-gradient(circle, rgb(185 151 255 / 24%), transparent 68%);
    filter: blur(8px);
    translate: -50% -50%;
    transition: top 700ms cubic-bezier(0.16, 1, 0.3, 1), left 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .ai-orbit img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 2rem 3.2rem rgb(0 0 0 / 48%));
    animation: ai-float 6s ease-in-out infinite;
  }

  .ai-orbit__halo {
    position: absolute;
    inset: 19% 8% 12%;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgb(122 60 255 / 24%), transparent 64%),
      radial-gradient(circle at 38% 56%, rgb(44 103 186 / 35%), transparent 52%);
    filter: blur(12px);
  }

  .ai-orbit__ring {
    position: absolute;
    top: 50%;
    left: 50%;
    border: 1px solid rgb(185 151 255 / 20%);
    border-radius: 50%;
    transform: translate(-50%, -50%) rotate(-16deg);
  }

  .ai-orbit__ring--outer {
    width: 102%;
    aspect-ratio: 1;
    border-style: dashed;
    animation: ai-ring 34s linear infinite;
  }

  .ai-orbit__ring--inner {
    width: 72%;
    aspect-ratio: 1;
    border-color: rgb(87 187 255 / 22%);
    animation: ai-ring 25s linear infinite reverse;
  }

  .ai-orbit__signal {
    position: absolute;
    z-index: 3;
    width: 0.58rem;
    aspect-ratio: 1;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--ai-purple);
    box-shadow: 0 0 1rem var(--ai-purple);
  }

  .ai-orbit__signal--one {
    top: 22%;
    right: 5%;
  }

  .ai-orbit__signal--two {
    bottom: 21%;
    left: 4%;
    animation-delay: -1.2s;
  }

  .ai-orbit figcaption {
    position: absolute;
    right: 0;
    bottom: 5%;
    z-index: 4;
    display: grid;
    gap: 0.25rem;
    padding: 0.8rem 1rem;
    border: 1px solid rgb(185 151 255 / 24%);
    border-radius: 0.75rem;
    color: rgb(223 245 255 / 62%);
    background: rgb(5 5 7 / 66%);
    font: 600 0.64rem/1.4 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.04em;
    backdrop-filter: blur(14px);
  }

  .ai-orbit figcaption span {
    color: var(--ai-glow);
    font-weight: 800;
  }

  .ai-scroll-cue {
    position: absolute;
    bottom: 1.2rem;
    left: 50%;
