---
export const prerender = false;

import { Image } from "astro:assets";
import LayoutNavbar from "../layouts/LayoutNavbar.astro";
import orbitAI from "../assets/img/ai-academy/orbit-ai-academy.png";
import { SITE_URL } from "../config/seo.mjs";
import { AI_ACADEMY_FAQS, workshopName, workshopPath, workshopWhatsappUrl } from "~/content/aiAcademy";
import { getLiveWorkshops } from "~/lib/ai-academy";
import "~/styles/index.css";
import "~/styles/ai-academy-tema.css";

const whatsappMessage = encodeURIComponent(
  "¡Hola! Me interesan los talleres de AI Academy de Campuslands Guatemala. ¿Podrían compartirme fechas, disponibilidad y costos?",
);
const whatsappUrl = `https://wa.me/50232705200?text=${whatsappMessage}`;

const activeWorkshops = await getLiveWorkshops();
const faqs = AI_ACADEMY_FAQS;

const dataFooter = {
  title: "Tu próximo sábado puede cambiar cómo trabajas toda la semana.",
  content:
    "Cuéntanos qué quieres transformar y te ayudaremos a elegir el taller de IA que mejor conecta con tu objetivo.",
  buttonType: "ia",
  buttonLink: whatsappUrl,
};

const structuredData = [
  {
    "@type": "ItemList",
    "@id": `${SITE_URL}/ai-academy/#talleres`,
    name: "Talleres de AI Academy de Campuslands Guatemala",
    itemListElement: activeWorkshops.map((workshop, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Course",
        "@id": `${SITE_URL}${workshopPath(workshop)}#curso`,
        name: workshopName(workshop),
        description: workshop.promise,
        url: `${SITE_URL}${workshopPath(workshop)}`,
        inLanguage: "es-GT",
        timeRequired: "PT16H",
        educationalLevel: "Introductorio a intermedio",
        provider: { "@id": `${SITE_URL}/#organization` },
        hasCourseInstance: {
          "@type": "CourseInstance",
          courseMode: "Presencial",
          courseWorkload: "PT16H",
          location: {
            "@type": "Place",
            name: "Campuslands Guatemala",
            address: "Campus Tec, Zona 4, Ciudad de Guatemala",
          },
        },
      },
    })),
  },
  {
    "@type": "FAQPage",
    "@id": `${SITE_URL}/ai-academy/#preguntas`,
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: { "@type": "Answer", text: faq.answer },
    })),
  },
];
---

<LayoutNavbar
  dataFooter={dataFooter}
  pageType="CollectionPage"
  structuredData={structuredData}
>
  <div class="ai-page">
    <section class="ai-hero" aria-labelledby="ai-hero-title">
      <div class="ai-hero__grid" aria-hidden="true"></div>
      <div class="ai-shell ai-hero__layout">
        <div class="ai-hero__copy">
          <p class="ai-kicker">
            <span></span>
            AI Academy · Campuslands Guatemala
          </p>
          <h1 id="ai-hero-title">
            Aprende IA.
            <span>Construye algo real.</span>
          </h1>
          <p class="ai-hero__lead">
            Cinco talleres presenciales para aplicar inteligencia artificial a
            fundamentos y agentes, marketing, finanzas, análisis de datos y
            automatización. Menos teoría y más manos a la obra para aprender. Convierte
            la IA en sistemas que puedes usar en tu profesión.
          </p>
          <div class="ai-actions">
            <a class="ai-button ai-button--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
              Quiero información
              <span aria-hidden="true">↗</span>
            </a>
            <a class="ai-button ai-button--ghost" href="#talleres">
              Explorar talleres
              <span aria-hidden="true">↓</span>
            </a>
          </div>
          <dl class="ai-metrics" aria-label="Formato de AI Academy">
            <div>
              <dt>04</dt>
              <dd>sábados</dd>
            </div>
            <div>
              <dt>16</dt>
              <dd>horas</dd>
            </div>
            <div class="ai-metrics__workshops">
              <dt>05</dt>
              <dd>
                <span>talleres</span>
                <strong>distintos</strong>
              </dd>
            </div>
          </dl>
          <p class="ai-metrics__note">
            <span class="ai-metrics__note-icon" aria-hidden="true">↳</span>
            <span>
              Elige tu ruta: cada taller es independiente y dura
              <strong>4 sábados · 16 horas.</strong>
            </span>
          </p>
        </div>

        <figure class="ai-orbit" data-ai-orbit>
          <div class="ai-orbit__halo" aria-hidden="true"></div>
          <div class="ai-orbit__ring ai-orbit__ring--outer" aria-hidden="true"></div>
          <div class="ai-orbit__ring ai-orbit__ring--inner" aria-hidden="true"></div>
          <span class="ai-orbit__signal ai-orbit__signal--one" aria-hidden="true"></span>
          <span class="ai-orbit__signal ai-orbit__signal--two" aria-hidden="true"></span>
          <Image
            src={orbitAI}
            alt="Orbit, astronauta de Campuslands, conectado a una red de inteligencia artificial azul y morada"
            format="avif"
            widths={[240, 360, 480, 720, 960]}
            sizes="(max-width: 719px) 64vw, (max-width: 1200px) 48vw, 620px"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption>
            <span>ORBIT_AI</span>
            Señal detectada · aprendizaje aplicado
          </figcaption>
        </figure>
      </div>
      <a class="ai-scroll-cue" href="#talleres">
        <span aria-hidden="true"></span>
        Desplázate para iniciar
      </a>
    </section>

    <section class="ai-manifesto" aria-labelledby="ai-manifesto-title" data-ai-reveal>
      <div class="ai-shell ai-manifesto__layout">
        <p class="ai-section-code" aria-hidden="true">01 / CAMBIA EL MÉTODO</p>
        <div>
          <h2 id="ai-manifesto-title">
            La IA no se aprende mirando.
            <span>Se aprende haciendo.</span>
          </h2>
          <p>
            Cada sábado convierte una pregunta real en un entregable. Aprendes
            el criterio para pedir, revisar y mejorar el trabajo de la IA; no
            una colección de trucos que caducan.
          </p>
        </div>
        <div class="ai-manifesto__signal" aria-label="Principio de aprendizaje">
          <span>Prompt</span>
          <i aria-hidden="true"></i>
          <span>Prototipo</span>
          <i aria-hidden="true"></i>
          <strong>Resultado</strong>
        </div>
      </div>
    </section>

    <section class="ai-workshops" id="talleres" aria-labelledby="ai-workshops-title">
      <div class="ai-shell">
        <div class="ai-section-head" data-ai-reveal>
          <div>
            <p class="ai-section-code">02 / ELIGE TU MISIÓN</p>
            <h2 id="ai-workshops-title">Cinco rutas. Un resultado aplicable.</h2>
          </div>
          <div class="ai-section-head__aside">
            <p>
              Arrastra, desliza o usa los controles para recorrer los talleres.
            </p>
            <div class="ai-track-controls" aria-label="Controles del catálogo">
              <button type="button" data-ai-track-prev aria-label="Ver taller anterior">
                ←
              </button>
              <span data-ai-track-count aria-live="polite">01 / 05</span>
              <button type="button" data-ai-track-next aria-label="Ver taller siguiente">
                →
              </button>
            </div>
          </div>
        </div>
      </div>

      <div
        class="ai-workshop-track"
        data-ai-workshop-track
        tabindex="0"
        aria-label="Catálogo horizontal de talleres"
      >
        {
          activeWorkshops.map((workshop, workshopIndex) => (
            <article
              class:list={[
                "ai-workshop-card",
                workshop.isOpen ? "ai-workshop-card--open" : "ai-workshop-card--upcoming"
              ]}
              id={workshop.id}
              data-ai-workshop-card
              data-workshop-id={workshop.id}
              data-workshop-open={workshop.isOpen ? "true" : "false"}
              aria-labelledby={`workshop-${workshop.id}`}
            >
              <div class="ai-workshop-card__top">
                <div class="ai-workshop-card__top-lead">
                  <p class="ai-workshop-card__code">{workshop.code}</p>
                  <span
                    class:list={[
                      "ai-status-pill",
                      workshop.isOpen ? "ai-status-pill--open" : "ai-status-pill--upcoming"
                    ]}
                    data-status-pill
                  >
                    <span class="ai-status-pill__dot" aria-hidden="true"></span>
                    <span data-status-text>{workshop.isOpen ? "Inscripciones abiertas" : "Próximamente"}</span>
                  </span>
                </div>

                <div class="ai-workshop-card__top-meta">
                  {workshop.startDate ? (
                    <span class="ai-workshop-card__date" data-date-pill>
                      <svg class="ai-icon-cal" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                      </svg>
                      <strong class="ai-date-label">Inicia:</strong>
                      <span data-date-text>{workshop.startDate}</span>
                    </span>
                  ) : null}
                  <span class="ai-workshop-card__format-tag">
                    16H · PRESENCIAL
                  </span>
                </div>
              </div>

              <div class="ai-workshop-card__intro">
                <div>
                  <span class="ai-workshop-card__number" aria-hidden="true">
                    {String(workshopIndex + 1).padStart(2, "0")}
                  </span>
                  <h3 id={`workshop-${workshop.id}`}>
                    {workshop.eyebrow && (
                      <span class="ai-workshop-card__eyebrow">{workshop.eyebrow}</span>
                    )}
                    {workshop.title}
                  </h3>
                </div>
                <p>{workshop.promise}</p>
              </div>

              <div class="ai-workshop-card__meta">
                <p><span>Ideal para</span>{workshop.audience}</p>
                <ul aria-label="Herramientas y enfoques">
                  {workshop.tools.map((tool) => <li>{tool}</li>)}
                </ul>
              </div>

              <ol class="ai-session-grid" aria-label="Ruta de cuatro sábados">
                {workshop.sessions.map((session, sessionIndex) => (
                  <li>
                    <div class="ai-session-grid__index">
                      <span>S{sessionIndex + 1}</span>
                      <i aria-hidden="true"></i>
                    </div>
                    <h4>{session.title}</h4>
                    <p>{session.description}</p>
                    <strong>{session.output}</strong>
                  </li>
                ))}
              </ol>

              <div class="ai-workshop-card__final">
                <p><span>Proyecto final</span>{workshop.final}</p>
                <div class="ai-workshop-card__actions">
                  <a
                    class="ai-btn-curriculum"
                    href={workshopPath(workshop)}
                    title={`Ver la malla curricular de ${workshopName(workshop)}`}
                  >
                    <svg class="ai-icon-doc" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                      <polyline points="14 2 14 8 20 8"></polyline>
                      <line x1="16" y1="13" x2="8" y2="13"></line>
                      <line x1="16" y1="17" x2="8" y2="17"></line>
                      <polyline points="10 9 9 9 8 9"></polyline>
                    </svg>
                    <span>Ver malla curricular</span>
                  </a>

                  <a
                    class="ai-workshop-card__cta"
                    href={workshopWhatsappUrl(workshop)}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span>{workshop.isOpen ? "Inscribirme al taller" : "Consultar este taller"}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
      <div class="ai-track-progress" aria-hidden="true">
        <span data-ai-track-progress></span>
      </div>
    </section>

    <section class="ai-format" aria-labelledby="ai-format-title">
      <div class="ai-shell">
        <div class="ai-section-head" data-ai-reveal>
          <div>
            <p class="ai-section-code">03 / CUATRO SÁBADOS</p>
            <h2 id="ai-format-title">Una idea por semana. Un sistema al final.</h2>
          </div>
          <p class="ai-section-head__copy">
            La experiencia avanza como un sprint: entender, construir, validar y
            presentar. Cada bloque de cuatro horas deja evidencia de progreso.
          </p>
        </div>

        <ol class="ai-timeline" data-ai-reveal>
          <li>
            <div><span>01</span><small>4 horas</small></div>
            <h3>Comprende</h3>
            <p>Define el problema, el contexto y el estándar de una buena respuesta.</p>
          </li>
          <li>
            <div><span>02</span><small>8 horas</small></div>
            <h3>Construye</h3>
            <p>Convierte el método en prompts, flujos, análisis o activos concretos.</p>
          </li>
          <li>
            <div><span>03</span><small>12 horas</small></div>
            <h3>Valida</h3>
            <p>Detecta errores, prueba supuestos y agrega control humano donde importa.</p>
          </li>
          <li>
            <div><span>04</span><small>16 horas</small></div>
            <h3>Activa</h3>
            <p>Presenta un proyecto aplicable y una ruta clara para seguir mejorándolo.</p>
          </li>
        </ol>
      </div>
    </section>

    <section class="ai-outcomes" aria-labelledby="ai-outcomes-title">
      <div class="ai-shell ai-outcomes__layout">
        <div class="ai-outcomes__copy" data-ai-reveal>
          <p class="ai-section-code">04 / CRITERIO + EJECUCIÓN</p>
          <h2 id="ai-outcomes-title">No solo usarás IA. Podrás dirigirla.</h2>
          <p>
            La ventaja no está en aceptar la primera respuesta. Está en
            estructurar el problema, dar contexto, verificar y convertir la
            salida en una decisión o un proceso.
          </p>
          <a class="ai-text-link" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
            Hablar con el equipo <span aria-hidden="true">↗</span>
          </a>
        </div>
        <ul class="ai-capability-grid" data-ai-reveal>
          <li>
            <span aria-hidden="true">⌁</span>
            <div><h3>Preguntar mejor</h3><p>Prompts con objetivo, contexto, restricciones y formato.</p></div>
          </li>
          <li>
            <span aria-hidden="true">◎</span>
            <div><h3>Validar siempre</h3><p>Criterios para revisar datos, supuestos, riesgos y calidad.</p></div>
          </li>
          <li>
            <span aria-hidden="true">↗</span>
            <div><h3>Diseñar sistemas</h3><p>Flujos repetibles que conectan herramientas, personas y decisiones.</p></div>
          </li>
          <li>
            <span aria-hidden="true">◇</span>
            <div><h3>Comunicar valor</h3><p>Resultados claros para clientes, equipos y líderes.</p></div>
          </li>
        </ul>
      </div>
    </section>

    <section class="ai-faq" id="preguntas" aria-labelledby="ai-faq-title">
      <div class="ai-shell ai-faq__layout">
        <div class="ai-faq__intro" data-ai-reveal>
          <p class="ai-section-code">05 / PREGUNTAS FRECUENTES</p>
          <h2 id="ai-faq-title">Antes de despegar.</h2>
          <p>
            Lo esencial para elegir tu taller y llegar preparado a la primera
            sesión.
          </p>
          <div class="ai-faq__status" aria-hidden="true">
            <span></span>
            Admisiones en línea
          </div>
        </div>
        <div class="ai-faq__items" data-ai-reveal>
          {
            faqs.map((faq, index) => (
              <details name="ai-academy-faq">
                <summary>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  {faq.question}
                  <i aria-hidden="true"></i>
                </summary>
                <p>{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="ai-final-cta" aria-labelledby="ai-final-title">
      <div class="ai-final-cta__grid" aria-hidden="true"></div>
      <div class="ai-shell ai-final-cta__content" data-ai-reveal>
        <p class="ai-section-code">SEÑAL ABIERTA · CUPOS POR COHORTE</p>
        <h2 id="ai-final-title">¿Qué quieres hacer mejor con IA?</h2>
        <p>
          Escríbenos. Te ayudamos a elegir el taller según tu rol, tu reto y el
          proyecto que quieres construir.
        </p>
        <a class="ai-button ai-button--primary" href={whatsappUrl} target="_blank" rel="noopener noreferrer">
          Consultar fechas y cupos
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

  </div>
</LayoutNavbar>

<script>
  function initializeAiAcademy() {
    window.__aiAcademyCleanup?.();

    const track = document.querySelector<HTMLElement>("[data-ai-workshop-track]");
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>("[data-ai-workshop-card]"),
    );
    const previous = document.querySelector<HTMLButtonElement>("[data-ai-track-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-ai-track-next]");
    const count = document.querySelector<HTMLElement>("[data-ai-track-count]");
    const progress = document.querySelector<HTMLElement>("[data-ai-track-progress]");
    const orbit = document.querySelector<HTMLElement>("[data-ai-orbit]");
    const revealItems = Array.from(
      document.querySelectorAll<HTMLElement>("[data-ai-reveal]"),
    );
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const finePointer = window.matchMedia("(pointer: fine)").matches;

    if (!track || cards.length === 0) return;

    let scrollFrame = 0;
    let activeIndex = 0;

    const updateTrackState = () => {
      scrollFrame = 0;
      const trackCenter = track.scrollLeft + track.clientWidth / 2;
      activeIndex = cards.reduce((closest, card, index) => {
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;
        const currentCenter =
          cards[closest].offsetLeft + cards[closest].offsetWidth / 2;
        return Math.abs(cardCenter - trackCenter) <
          Math.abs(currentCenter - trackCenter)
          ? index
          : closest;
      }, 0);

      if (count) {
        count.textContent = `${String(activeIndex + 1).padStart(2, "0")} / ${String(cards.length).padStart(2, "0")}`;
      }
      previous?.toggleAttribute("disabled", activeIndex === 0);
      next?.toggleAttribute("disabled", activeIndex === cards.length - 1);

      const maxScroll = Math.max(track.scrollWidth - track.clientWidth, 1);
      progress?.style.setProperty(
        "--ai-track-progress",
        String(Math.min(track.scrollLeft / maxScroll, 1)),
      );
    };

    const requestTrackUpdate = () => {
      if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateTrackState);
    };

    const goToCard = (index: number) => {
      const target = cards[Math.max(0, Math.min(index, cards.length - 1))];
      target?.scrollIntoView({
        behavior: reduceMotion ? "auto" : "smooth",
        block: "nearest",
        inline: "center",
      });
    };

    const goPrevious = () => goToCard(activeIndex - 1);
    const goNext = () => goToCard(activeIndex + 1);
    const handleKeyboard = (event: KeyboardEvent) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        goPrevious();
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        goNext();
      }
    };

    const handleOrbitPointer = (event: PointerEvent) => {
      if (!orbit) return;
      const bounds = orbit.getBoundingClientRect();
      orbit.style.setProperty("--orbit-pointer-x", `${event.clientX - bounds.left}px`);
      orbit.style.setProperty("--orbit-pointer-y", `${event.clientY - bounds.top}px`);
    };

    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          (entry.target as HTMLElement).dataset.aiVisible = "true";
          revealObserver.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -8%" },
    );

    revealItems.forEach((item) => {
      if (reduceMotion || item.getBoundingClientRect().top < window.innerHeight * 0.9) {
        item.dataset.aiVisible = "true";
      } else {
        revealObserver.observe(item);
      }
    });

    track.addEventListener("scroll", requestTrackUpdate, { passive: true });
    track.addEventListener("keydown", handleKeyboard);
    previous?.addEventListener("click", goPrevious);
    next?.addEventListener("click", goNext);
    if (finePointer) orbit?.addEventListener("pointermove", handleOrbitPointer);
    window.addEventListener("resize", requestTrackUpdate, { passive: true });
    updateTrackState();

    window.__aiAcademyCleanup = () => {
      revealObserver.disconnect();
      track.removeEventListener("scroll", requestTrackUpdate);
      track.removeEventListener("keydown", handleKeyboard);
      previous?.removeEventListener("click", goPrevious);
      next?.removeEventListener("click", goNext);
      orbit?.removeEventListener("pointermove", handleOrbitPointer);
      window.removeEventListener("resize", requestTrackUpdate);
      if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
    };
  }

  document.addEventListener("astro:page-load", initializeAiAcademy);
  document.addEventListener("astro:before-swap", () => {
    window.__aiAcademyCleanup?.();
  });
</script>

<style is:global>


  .ai-hero {
    position: relative;
    display: grid;
    min-height: calc(100svh - 5.5rem);
    place-items: center;
    overflow: hidden;
    padding: clamp(3rem, 7vw, 6.5rem) 0 5rem;
    isolation: isolate;
  }

  .ai-hero::before {
    position: absolute;
    inset: 0;
    z-index: -2;
    content: "";
    background:
      radial-gradient(circle at 76% 44%, rgb(122 60 255 / 22%), transparent 27%),
      radial-gradient(circle at 72% 46%, rgb(44 103 186 / 26%), transparent 43%),
      linear-gradient(112deg, #000051 0%, #07052b 52%, #050507 100%);
  }

  .ai-hero::after {
    position: absolute;
    inset: auto 0 0;
    z-index: -1;
    height: 16rem;
    content: "";
    background: linear-gradient(transparent, #050507);
  }

  .ai-hero__grid,
  .ai-final-cta__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.18;
    background-image:
      linear-gradient(rgb(185 151 255 / 15%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(87 187 255 / 12%) 1px, transparent 1px);
    background-size: 74px 74px;
    mask-image: linear-gradient(90deg, #000 0%, #000 68%, transparent 96%);
  }

  .ai-hero__layout {
    display: grid;
    align-items: center;
    gap: 2rem;
  }

  .ai-hero__copy {
    position: relative;
    z-index: 2;
  }




  .ai-hero h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(3rem, 12vw, 6.8rem);
    font-weight: 800;
    line-height: 0.94;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .ai-hero h1 span {
