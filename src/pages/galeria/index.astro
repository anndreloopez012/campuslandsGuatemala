---
import LayoutNavbar from "~/layouts/LayoutNavbar.astro";
import { blogMediaSrcset, blogSeoDescription, blogSeoTitle, colorRgb, filterGalleriesBySection, formatBlogDate, getBlogData, safeCategoryColor } from "~/lib/blog";
import { PAGE_SEO, SITE, SITE_URL } from "~/config/seo.mjs";
import "~/styles/index.css";
import "~/styles/galeria.css";

// Galería pública separada por programa:
// - ?seccion=ai-academy -> Galería exclusiva de AI Academy
// - ?seccion=join-us (o ?seccion=codeup) -> Galería exclusiva de CodeUp · Sé un Camper
export const prerender = false;
Astro.response.headers.set("Cache-Control", "public, max-age=0, must-revalidate");

const rawSection = (Astro.url.searchParams.get("seccion") || "").toLowerCase();
const { settings, galleries, categories } = await getBlogData();
const joinUsGalleries = filterGalleriesBySection(galleries, "join-us");
const aiAcademyGalleries = filterGalleriesBySection(galleries, "ai-academy");

const activeSection: "join-us" | "ai-academy" =
  rawSection === "join-us" || rawSection === "codeup"
    ? "join-us"
    : rawSection === "ai-academy"
      ? "ai-academy"
      : aiAcademyGalleries.length > 0
        ? "ai-academy"
        : "join-us";

const isAiAcademy = activeSection === "ai-academy";
const scopedGalleries = isAiAcademy ? aiAcademyGalleries : joinUsGalleries;

const totalPhotos = scopedGalleries.reduce((sum, gallery) => sum + gallery.images.length, 0);
const latestUpdate = scopedGalleries.map((gallery) => gallery.modifiedDate).filter(Boolean).sort().at(-1);
const latestDate = scopedGalleries.map((gallery) => gallery.publishDate).filter(Boolean).sort().at(-1);
const featured =
  scopedGalleries.find((gallery) => gallery.featured && gallery.images.length) ??
  scopedGalleries.find((gallery) => gallery.images.length) ??
  null;
const usedCategories = categories.filter((category) =>
  scopedGalleries.some((gallery) => gallery.category.slug === category.slug),
);
// Cinta de fondo exclusiva de la sección activa (nunca mezcla fotos del otro programa).
const strip = scopedGalleries
  .flatMap((gallery) => gallery.images.slice(0, 5).map((image, index) => ({ image, gallery, index })))
  .sort((a, b) => a.index - b.index || a.gallery.publishDate.localeCompare(b.gallery.publishDate))
  .slice(0, 14);

const seo = PAGE_SEO["/galeria/"];
const sectionTitleText = isAiAcademy
  ? "Galería AI Academy | Campuslands Guatemala"
  : "Galería CodeUp · Sé un Camper | Campuslands Guatemala";
const sectionDescriptionText = isAiAcademy
  ? "Archivo fotográfico oficial de los talleres prácticos, laboratorios de IA y cohortes de AI Academy en Campuslands Guatemala."
  : "Archivo fotográfico oficial de entrenamientos de desarrollo de software, comunidad Camper y programa CodeUp en Campuslands Guatemala.";
const title = blogSeoTitle(sectionTitleText, seo.title);
const description = blogSeoDescription(sectionDescriptionText, seo.description);
const dataFooter = settings ? { title: settings.footerTitle, content: settings.footerDescription, buttonType: "contacto" } : undefined;
const structuredData = [{
  "@type": "CollectionPage",
  "@id": `${SITE_URL}/galeria/?seccion=${activeSection}#collection`,
  name: sectionTitleText,
  description,
  dateModified: latestUpdate,
  inLanguage: SITE.language,
  mainEntity: {
    "@type": "ItemList",
    numberOfItems: scopedGalleries.length,
    itemListElement: scopedGalleries.map((gallery, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: gallery.title,
      url: `${SITE_URL}/galeria/${gallery.slug}/?seccion=${activeSection}`,
    })),
  },
}];
const pad = (value: number) => String(value).padStart(2, "0");
const catStyle = (color?: string) => `--cat:${safeCategoryColor(color)};--cat-rgb:${colorRgb(safeCategoryColor(color))}`;
const galleryHref = (slug: string) => `/galeria/${slug}/?seccion=${activeSection}`;
---

<LayoutNavbar dataFooter={dataFooter} title={title} description={description} image={featured?.images[0]?.url} pageType="CollectionPage" modifiedTime={latestUpdate} structuredData={structuredData}>
  <div class:list={["gal", `gal--${activeSection}`]} data-gal>
    <header class="gal-hero">
      {strip.length > 0 && (
        <div class="gal-strip" aria-hidden="true">
          <div class="gal-strip__track">
            {[...strip, ...strip].map(({ image }) => <img src={image.formats?.small?.url || image.formats?.medium?.url || image.url} alt="" width={image.width} height={image.height} loading="eager" decoding="async" />)}
          </div>
        </div>
      )}
      <div class="gal-hero__body sections">
        <div class="gal-hero__top-row">
          <p class="gal-eyebrow">
            <i aria-hidden="true"></i>
            <span>
              {isAiAcademy
                ? "AI.GAL · Galería Oficial · AI Academy"
                : "CODEUP · Galería Oficial · Sé un Camper"}
            </span>
          </p>
          <a
            class="gal-origin-back"
            href={isAiAcademy ? "/ai-academy/" : "/joinUs/"}
          >
            <span aria-hidden="true">←</span>
            <span>{isAiAcademy ? "Volver a AI Academy" : "Volver a Sé un Camper"}</span>
          </a>
        </div>
        <h1>
          {isAiAcademy ? (
            <>Así vivimos los talleres de <em>AI Academy</em></>
          ) : (
            <>La experiencia de nuestra <em>comunidad Camper y CodeUp</em></>
          )}
        </h1>
        <p class="gal-hero__text">
          {isAiAcademy
            ? "Laboratorios prácticos, sesiones en vivo, construcción de agentes y momentos reales de nuestras cohortes de inteligencia artificial en Campus Tec."
            : "Entrenamiento intensivo en desarrollo de software, retos técnicos en equipo, graduaciones y el día a día de formarse como Camper en Campuslands."}
        </p>
        <dl class="gal-stats">
          <div><dt>{isAiAcademy ? "Galerías AI Academy" : "Galerías CodeUp"}</dt><dd>{pad(scopedGalleries.length)}</dd></div>
          <div><dt>Fotografías</dt><dd>{pad(totalPhotos)}</dd></div>
          {latestDate && <div><dt>Última galería</dt><dd>{formatBlogDate(latestDate)}</dd></div>}
        </dl>
      </div>
    </header>

    {featured && (
      <section class="gal-featured sections" aria-label="Galería destacada" data-reveal>
        <a class="gal-feature" href={galleryHref(featured.slug)} style={catStyle(featured.category.color)}>
          <div class:list={["gal-feature__media", `gal-feature__media--${Math.min(featured.images.length, 4)}`]} aria-hidden="true">
            {featured.images.slice(0, 4).map((image, index) => <img src={image.formats?.large?.url || image.url} srcset={blogMediaSrcset(image)} sizes="(max-width: 1360px) 100vw, 1360px" alt="" loading={index === 0 ? "eager" : "lazy"} decoding="async" />)}
          </div>
          <div class="gal-feature__body">
            <p class="gal-eyebrow"><i></i>{featured.featured ? "Destacada" : "Más reciente"} · {featured.category.name}</p>
            <h2>{featured.title}</h2>
            <p>{featured.description}</p>
            <footer><span>{formatBlogDate(featured.publishDate)}</span><span>{pad(featured.images.length)} fotografías</span><b>Ver galería <span aria-hidden="true">→</span></b></footer>
          </div>
        </a>
      </section>
    )}

    {scopedGalleries.length > 0 ? (
      <>
        {usedCategories.length > 1 && (
          <div class="gal-filter-bars sections" data-reveal>
            <nav class="gal-filters" aria-label="Filtrar galerías por categoría">
              <span>Categoría</span>
              <button type="button" class="gal-chip is-active" data-filter="todas" aria-pressed="true">Todas <small>{pad(scopedGalleries.length)}</small></button>
              {usedCategories.map((category) => (
                <button type="button" class="gal-chip" data-filter={category.slug} aria-pressed="false" style={catStyle(category.color)}>{category.name} <small>{pad(scopedGalleries.filter((gallery) => gallery.category.slug === category.slug).length)}</small></button>
              ))}
            </nav>
          </div>
        )}

        <section class="gal-grid sections" aria-label={isAiAcademy ? "Galerías de AI Academy" : "Galerías de CodeUp y Sé un Camper"} data-grid>
          {scopedGalleries.map((gallery, index) => (
            <article
              class="gal-card"
              data-cat={gallery.category.slug}
              style={`${catStyle(gallery.category.color)};--delay:${(index % 3) * 0.08}s`}
              data-reveal
            >
              <a href={galleryHref(gallery.slug)}>
                <div class:list={["gal-card__mosaic", `gal-card__mosaic--${Math.min(gallery.images.length, 3)}`]}>
                  {gallery.images.slice(0, 3).map((image, imageIndex) => <img src={image.formats?.medium?.url || image.url} alt={imageIndex === 0 ? image.alternativeText || gallery.title : ""} width={image.width} height={image.height} loading={index < 3 ? "eager" : "lazy"} decoding="async" />)}
                  {!gallery.images.length && <span>{"{ 00 }"}</span>}
                  <b>{pad(gallery.images.length)} fotos</b>
                </div>
                <div class="gal-card__body">
                  <div class="gal-card__eyebrow-row">
                    <p class="gal-eyebrow"><i></i>{gallery.category.name}</p>
                    <span class:list={["gal-card__section-pill", `gal-card__section-pill--${activeSection}`]}>
                      {isAiAcademy ? "AI Academy" : "CodeUp · Camper"}
                    </span>
                  </div>
                  <h2>{gallery.title}</h2>
                  <p>{gallery.description}</p>
                  <footer><span>{formatBlogDate(gallery.publishDate)}</span><b>Abrir galería</b></footer>
                </div>
              </a>
            </article>
          ))}
        </section>
        <div class="gal-empty sections" data-no-results hidden>
          <span>{"{ 00 }"}</span>
          <h2>No hay galerías en esta categoría</h2>
        </div>
      </>
    ) : (
      <section class="gal-empty sections">
        <span>{"{ 00 }"}</span>
        <h2>
          {isAiAcademy
            ? "Todavía no hay galerías publicadas en AI Academy"
            : "Todavía no hay galerías publicadas en CodeUp · Sé un Camper"}
        </h2>
        <p>
          {isAiAcademy
            ? "Las próximas fotografías de nuestros talleres y laboratorios de inteligencia artificial aparecerán aquí muy pronto."
            : "Las próximas fotografías de nuestros entrenamientos de desarrollo de software y comunidad Camper aparecerán aquí muy pronto."}
        </p>
      </section>
    )}
    <div class="gal-end"></div>
  </div>
</LayoutNavbar>

<script>
  function initGallery() {
    const root = document.querySelector<HTMLElement>("[data-gal]");
    if (!root || root.classList.contains("js-ready")) return;
    root.classList.add("js-ready");

    // Aparición suave al entrar en pantalla.
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add("is-in"); observer.unobserve(entry.target); } });
    }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
    root.querySelectorAll("[data-reveal]").forEach((node) => observer.observe(node));

    const catChips = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const cards = Array.from(root.querySelectorAll<HTMLElement>(".gal-card"));
    const empty = root.querySelector<HTMLElement>("[data-no-results]");

    catChips.forEach((chip) =>
      chip.addEventListener("click", () => {
        const filter = chip.dataset.filter || "todas";
        catChips.forEach((item) => {
          const active = item === chip;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-pressed", String(active));
        });
        let visible = 0;
        cards.forEach((card) => {
          const show = filter === "todas" || card.dataset.cat === filter;
          card.classList.toggle("is-hidden", !show);
          if (show) {
            visible += 1;
            card.classList.add("is-in");
          }
        });
        if (empty) empty.hidden = visible > 0;
      }),
    );
  }
  document.addEventListener("astro:page-load", initGallery);
  initGallery();
</script>
