---
export const prerender = false;

import LayoutNavbar from "~/layouts/LayoutNavbar.astro";
import CampusIcon from "~/components/ai-academy/CampusIcon.astro";
import { AI_ACADEMY_WHATSAPP } from "~/content/aiAcademy";
import { campusData, loginStudent, setCampusSession } from "~/lib/academy-campus";
import "~/styles/index.css";
import "~/styles/codeup-campus.css";

let error = "";
let email = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  email = String(form.get("email") ?? "").slice(0, 160);
  const password = String(form.get("password") ?? "");
  if (!email || !password) {
    error = "Escribe tu correo y tu contraseña.";
  } else {
    const result = await loginStudent(email, password, "codeup");
    if ("error" in result) {
      error = result.error ?? "No pudimos iniciar tu sesión.";
    } else {
      setCampusSession(Astro.cookies, result.token);
      return Astro.redirect(result.data.student.mustChangePassword ? "/codeup/campus/clave/" : "/codeup/campus/", 303);
    }
  }
} else if (await campusData(Astro.cookies, "codeup")) {
  return Astro.redirect("/codeup/campus/", 302);
}

const help = `https://wa.me/${AI_ACADEMY_WHATSAPP}?text=${encodeURIComponent("¡Hola! Soy camper de CodeUp y necesito ayuda para ingresar a mi campus.")}`;
const dataFooter = {
  title: "¿Problemas para ingresar a tu campus CodeUp?",
  content: "Escríbenos por WhatsApp y te ayudamos a recuperar tu acceso.",
  buttonType: "insripcion",
  buttonLink: help,
};
---

<LayoutNavbar dataFooter={dataFooter} title="Campus CodeUp | Sé un Camper Campuslands" description="Ingresa a tu campus CodeUp para ver tus entregables, módulos, videos y diplomas verificables." noindex>
  <section class="cx acceso" aria-labelledby="acceso-titulo">
    <div class="cx-sky" aria-hidden="true"></div>
    <div class="cx-shell acceso__layout">
      <div class="acceso__copy">
        <p class="cx-kicker"><i></i>CodeUp · Campus de Campers</p>
        <h1 id="acceso-titulo">Tu ruta en <span>CodeUp.</span></h1>
        <p class="acceso__lead">Tus entregables técnicos, recursos de cada módulo, sesiones grabadas y diplomas verificables para LinkedIn en un solo lugar.</p>
        <ul class="acceso__features">
          <li><b><CampusIcon name="diploma" /></b><span><strong>Diplomas verificables</strong>Agrégalos a tu perfil de LinkedIn con un clic y código oficial.</span></li>
          <li><b><CampusIcon name="herramienta" size={19} /></b><span><strong>Entregables y recursos</strong>Repositorios, guías técnicas y retos de cada módulo.</span></li>
          <li><b><CampusIcon name="video" /></b><span><strong>Sesiones y clases</strong>Repasa cada módulo y continúa donde quedaste.</span></li>
        </ul>
        <div class="acceso__code-badge" aria-hidden="true">
          <span>&lt;codeup_campus status="ready" /&gt;</span>
        </div>
      </div>

      <form class="cx-glass acceso__card" method="post" novalidate data-acceso>
        <div class="acceso__card-top">
          <span class="acceso__badge">ACCESO CAMPER</span>
          <span class="acceso__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        </div>
        <h2>Ingresa a tu campus CodeUp</h2>
        <p class="acceso__hint">Usa el correo y la contraseña que te asignó el equipo de formación de Campuslands.</p>

        {error && <p class="cx-alert" role="alert">{error}</p>}

        <label class="cx-field">
          Correo
          <input type="email" name="email" value={email} autocomplete="username" required autofocus={!email} inputmode="email" />
        </label>
        <label class="cx-field">
          Contraseña
          <span class="cx-input">
            <input type="password" name="password" autocomplete="current-password" required autofocus={Boolean(email)} data-password />
            <button type="button" class="cx-eye" data-eye aria-label="Mostrar contraseña">Ver</button>
          </span>
        </label>

        <button type="submit" class="cx-btn acceso__submit" data-submit>
          <span data-submit-label>Entrar a CodeUp</span>
          <span aria-hidden="true">→</span>
        </button>

        <div class="acceso__foot">
          <a href={help} target="_blank" rel="noopener noreferrer">¿Olvidaste tu contraseña? Escríbenos ↗</a>
          <a href="/joinUs/">← Volver a Sé un Camper</a>
        </div>
      </form>
    </div>
  </section>
</LayoutNavbar>

<script>
  function initAcceso() {
    const form = document.querySelector<HTMLFormElement>("[data-acceso]");
    if (!form) return;
    const input = form.querySelector<HTMLInputElement>("[data-password]");
    const eye = form.querySelector<HTMLButtonElement>("[data-eye]");
    eye?.addEventListener("click", () => {
      if (!input) return;
      const show = input.type === "password";
      input.type = show ? "text" : "password";
      eye.textContent = show ? "Ocultar" : "Ver";
      eye.setAttribute("aria-label", show ? "Ocultar contraseña" : "Mostrar contraseña");
    });
    form.addEventListener("submit", () => {
      const label = form.querySelector<HTMLElement>("[data-submit-label]");
      form.querySelector<HTMLButtonElement>("[data-submit]")?.setAttribute("aria-busy", "true");
      if (label) label.textContent = "Ingresando…";
    });
  }
  document.addEventListener("astro:page-load", initAcceso);
</script>

<style>
  .acceso {
    display: grid;
    place-items: center;
    padding: clamp(2.5rem, 7vw, 5rem) 0;
  }

  .acceso__layout {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .acceso h1 {
    max-width: 12ch;
    margin: 1rem 0 0;
    font-size: clamp(2.6rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .acceso h1 span {
    color: transparent;
    background: linear-gradient(110deg, #2caaff, #dff5ff 42%, #00aa80 85%);
    background-clip: text;
  }

  .acceso__lead {
    max-width: 34rem;
    margin-top: 1.2rem;
    color: var(--cx-text);
    font-size: 1.08rem;
    line-height: 1.7;
  }

  .acceso__features {
    display: grid;
    gap: 0.7rem;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .acceso__features li {
    display: flex;
    gap: 0.85rem;
    align-items: center;
    color: var(--cx-text);
    font-size: 0.9rem;
  }

  .acceso__features b {
    display: grid;
    width: 2.6rem;
    height: 2.6rem;
    flex: none;
    place-items: center;
    border: 1px solid rgb(44 170 255 / 32%);
    border-radius: 0.9rem;
    background: rgb(44 170 255 / 12%);
    color: #2caaff;
  }

  .acceso__features strong {
    display: block;
    color: #fff;
    font-size: 0.95rem;
  }

  .acceso__code-badge {
    display: inline-flex;
    margin-top: 1.6rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid rgb(44 170 255 / 24%);
    border-radius: 999px;
    background: rgb(0 0 81 / 55%);
    color: rgb(87 187 255 / 85%);
    font: 700 0.74rem/1.2 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.08em;
  }

  .acceso__card {
    display: grid;
    gap: 1rem;
    width: min(100%, 28rem);
    justify-self: center;
    padding: clamp(1.5rem, 4vw, 2.3rem);
  }

  .acceso__card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .acceso__badge {
    padding: 0.32rem 0.7rem;
    border: 1px solid rgb(0 170 128 / 45%);
    border-radius: 999px;
    color: #7fffdc;
    background: rgb(0 170 128 / 12%);
    font: 700 0.6rem/1 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.14em;
  }

  .acceso__dots {
    display: flex;
    gap: 0.3rem;
  }

  .acceso__dots i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: rgb(44 170 255 / 40%);
  }

  .acceso__dots i:first-child {
    background: #00aa80;
    box-shadow: 0 0 10px #00aa80;
  }

  .acceso__card h2 {
    margin: 0.3rem 0 0;
    font-size: clamp(1.6rem, 4vw, 2rem);
    letter-spacing: -0.04em;
  }

  .acceso__hint {
    margin: -0.4rem 0 0.3rem;
    color: var(--cx-text);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .acceso__submit {
    width: 100%;
    margin-top: 0.3rem;
  }

  .acceso__submit[aria-busy="true"] {
    opacity: 0.75;
    pointer-events: none;
  }

  .acceso__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--cx-line);
    font-size: 0.82rem;
  }

  .acceso__foot a {
    color: #57bbff;
    text-decoration: none;
  }

  .acceso__foot a:hover {
    color: #fff;
  }

  @media (min-width: 960px) {
    .acceso__layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    }

    .acceso__card {
      justify-self: end;
    }
  }
</style>
