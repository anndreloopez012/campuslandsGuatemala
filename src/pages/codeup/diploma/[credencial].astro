---
export const prerender = false;

import LayoutNavbar from "~/layouts/LayoutNavbar.astro";
import DiplomaReplica from "~/components/ai-academy/DiplomaReplica.astro";
import type { DiplomaDesign, DiplomaSeal, DiplomaSignature } from "~/lib/academy-diploma";
import CampusIcon from "~/components/ai-academy/CampusIcon.astro";
import { SITE_URL } from "~/config/seo.mjs";
import { AI_ACADEMY_WHATSAPP } from "~/content/aiAcademy";
import { diplomaSignatureFor, formatDiplomaDate, linkedinShareUrl, verifyDiploma } from "~/lib/academy-campus";
import "~/styles/index.css";
import "~/styles/codeup-campus.css";

type Verified = {
  credentialId: string; status: string; title: string; issuedAt: string; hours: number; skills: string[];
  student: { fullName: string }; workshop: { code: string; title: string; slug: string; accent: string; program?: string };
  design?: Partial<DiplomaDesign> | null;
  seal?: DiplomaSeal | null;
  signature?: DiplomaSignature | null;
};

const credencial = String(Astro.params.credencial ?? "").toUpperCase().slice(0, 40);
const diploma = /^[A-Z0-9-]{6,40}$/.test(credencial) ? ((await verifyDiploma(credencial)) as Verified | null) : null;
if (!diploma) Astro.response.status = 404;

const revoked = diploma?.status === "revocado";
const url = `${SITE_URL}/codeup/diploma/${credencial}/`;
const title = diploma ? `${diploma.student.fullName} · ${diploma.title} | CodeUp Campuslands` : "Diploma no encontrado | CodeUp Campuslands";
const description = diploma
  ? `${diploma.student.fullName} completó ${diploma.title} en CodeUp de Campuslands Guatemala (${diploma.hours} horas). Credencial ${diploma.credentialId}.`
  : "Verificación de diplomas de CodeUp de Campuslands Guatemala.";
const dataFooter = {
  title: "¿Quieres formarte como desarrollador en Campuslands?",
  content: "Conoce el programa Sé un Camper y CodeUp con formación intensiva y credenciales verificables.",
  buttonType: "insripcion",
  buttonLink: `https://wa.me/${AI_ACADEMY_WHATSAPP}?text=${encodeURIComponent("¡Hola! Vi un diploma de CodeUp y quiero información sobre el programa.")}`,
};
---

<LayoutNavbar dataFooter={dataFooter} title={title} description={description} noindex>
  <section class="cx verify" style={`--cx-accent: ${diploma?.workshop.accent ?? "#2caaff"};`}>
    <div class="cx-sky" aria-hidden="true"></div>
    <div class="cx-shell verify__shell">
      {diploma ? (
        <>
          <div class:list={["verify__stamp", revoked && "is-revoked"]} role="status">
            <span aria-hidden="true">{revoked ? <CampusIcon name="cerrar" size={18} /> : <CampusIcon name="check" size={18} />}</span>
            <div>
              <strong>{revoked ? "Credencial revocada" : "Credencial verificada"}</strong>
              <small>{revoked ? "Este diploma ya no es válido. Si crees que es un error, escríbenos." : "Emitida por Campuslands Guatemala · CodeUp"}</small>
            </div>
          </div>

          <h1 class="verify__sr">Diploma de {diploma.student.fullName}: {diploma.title}</h1>
          <DiplomaReplica fullName={diploma.student.fullName} title={diploma.title} hours={diploma.hours} issuedAt={diploma.issuedAt} credentialId={diploma.credentialId} verifyUrl={url} design={diploma.design} seal={diploma.seal} signature={diplomaSignatureFor(diploma.signature)} revoked={revoked} />
          <dl class="cx-glass verify__meta">
            <div><dt>Otorgado a</dt><dd>{diploma.student.fullName}</dd></div>
            <div><dt>Emitido</dt><dd>{formatDiplomaDate(diploma.issuedAt)}</dd></div>
            <div><dt>ID de credencial</dt><dd>{diploma.credentialId}</dd></div>
            <div><dt>Horas</dt><dd>{diploma.hours}</dd></div>
            <div><dt>Emisor</dt><dd>Campuslands Guatemala · CodeUp</dd></div>
          </dl>
          {diploma.skills.length > 0 && <ul class="cx-skills">{diploma.skills.map((skill) => <li>{skill}</li>)}</ul>}

          <div class="verify__actions">
            {!revoked && <a class="cx-btn cx-btn--linkedin" href={linkedinShareUrl(url)} target="_blank" rel="noopener noreferrer">Compartir en LinkedIn</a>}
            <a class="cx-btn cx-btn--ghost" href="/joinUs/">Conocer Sé un Camper · CodeUp →</a>
          </div>
        </>
      ) : (
        <div class="cx-glass verify__missing">
          <span aria-hidden="true"><CampusIcon name="escudo" size={30} /></span>
          <h1>No encontramos ese diploma</h1>
          <p>Revisa que el identificador esté completo. Tiene la forma <code>CLGT-MODULO-AAMM-XXXXXX</code>.</p>
          <a class="cx-btn" href="/joinUs/">Ir a Sé un Camper</a>
        </div>
      )}
    </div>
  </section>
</LayoutNavbar>

<style>
  .verify { display: grid; place-items: center; padding: clamp(2.5rem, 7vw, 5rem) 0; }
  .verify__shell { display: grid; gap: 1.4rem; max-width: 56rem; }

  .verify__stamp { display: flex; align-items: center; gap: 0.9rem; justify-self: start; padding: 0.7rem 1.1rem 0.7rem 0.7rem; border: 1px solid rgb(0 170 128 / 45%); border-radius: 999px; background: rgb(0 170 128 / 12%); }
  .verify__stamp > span { display: grid; width: 2.4rem; height: 2.4rem; place-items: center; border-radius: 50%; color: #050507; background: #00aa80; font-weight: 900; box-shadow: 0 0 1.4rem rgb(0 170 128 / 50%); }
  .verify__stamp strong { display: block; color: #7fffdc; }
  .verify__stamp small { color: rgb(223 245 255 / 70%); font-size: 0.8rem; }
  .verify__stamp.is-revoked { border-color: rgb(255 100 120 / 45%); background: rgb(255 67 91 / 8%); }
  .verify__stamp.is-revoked > span { background: #ff8a9b; box-shadow: none; }
  .verify__stamp.is-revoked strong { color: #ffc4cc; }

  .verify__actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .verify__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .verify__meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 1rem; margin: 0; padding: 1.2rem 1.4rem; }
  .verify__meta dt { color: rgb(223 245 255 / 55%); font: 700 0.6rem/1.4 Menlo, Monaco, Consolas, monospace; letter-spacing: 0.14em; text-transform: uppercase; }
  .verify__meta dd { margin: 0.3rem 0 0; font-weight: 700; }

  .verify__missing { display: grid; justify-items: center; gap: 0.9rem; padding: clamp(2rem, 6vw, 3.5rem); text-align: center; }
  .verify__missing > span { display: grid; width: 4rem; height: 4rem; place-items: center; border-radius: 1.3rem; background: rgb(44 170 255 / 20%); color: #2caaff; }
  .verify__missing h1 { margin: 0; font-size: clamp(1.5rem, 4vw, 2.2rem); letter-spacing: -0.04em; }
  .verify__missing p { max-width: 30rem; margin: 0; color: var(--cx-text); line-height: 1.6; }
  .verify__missing code { color: #fff; }

  @media (max-width: 640px) {
    .verify__actions .cx-btn { width: 100%; }
  }
</style>
